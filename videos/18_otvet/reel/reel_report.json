 "captions": [
  {
   "t0": 0.0,
   "t1": 0.26,
   "text": "Ответить"
  },
  {
   "t0": 0.26,
   "t1": 0.82,
   "text": "другу секунда,"
  },
  {
   "t0": 0.82,
   "t1": 0.94,
   "text": "а ты"
  },
  {
   "t0": 0.94,
   "t1": 1.24,
   "text": "не отвечаешь"
  },
  {
   "t0": 1.24,
   "t1": 3.293,
   "text": "неделю?"
  },
  {
   "t0": 3.293,
   "t1": 3.973,
   "text": "Сообщение так"
  },
  {
   "t0": 3.973,
   "t1": 4.973,
   "text": "и висит,"
  },
  {
   "t0": 4.973,
   "t1": 5.373,
   "text": "но это"
  },
  {
   "t0": 5.373,
   "t1": 6.173,
   "text": "не лень."
  },
  {
   "t0": 6.173,
   "t1": 7.173,
   "text": "В конце покажу,"
  },
  {
   "t0": 7.173,
   "t1": 8.733,
   "text": "как ответить сегодня."
  },
  {
   "t0": 8.733,
   "t1": 9.133,
   "text": "Я так"
  },
  {
   "t0": 9.133,
   "t1": 10.173,
   "text": "молчал другу"
  },
  {
   "t0": 10.173,
   "t1": 10.853,
   "text": "и стыдился"
  },
  {
   "t0": 10.853,
   "t1": 12.013,
   "text": "всё сильнее."
  },
  {
   "t0": 12.013,
   "t1": 13.293,
   "text": "Чем дольше молчишь,"
  },
  {
   "t0": 13.293,
   "t1": 14.093,
   "text": "тем длиннее"
  },
  {
   "t0": 14.093,
   "t1": 15.213,
   "text": "кажется ответ,"
  },
  {
   "t0": 15.213,
   "t1": 15.413,
   "text": "а в"
  },
  {
   "t0": 15.413,
   "t1": 16.413,
   "text": "исследовании Лю"
  },
  {
   "t0": 16.413,
   "t1": 17.453,
   "text": "короткой весточке"
  },
  {
   "t0": 17.453,
   "t1": 18.333,
   "text": "радовались."
  },
  {
   "t0": 18.333,
   "t1": 19.213,
   "text": "Напиши слово"
  },
  {
   "t0": 19.213,
   "t1": 20.333,
   "text": "кот в комментариях"
  },
  {
   "t0": 20.333,
   "t1": 21.493,
   "text": "и котик Напарник"
  },
  {
   "t0": 21.493,
   "t1": 22.133,
   "text": "поможет тебе"
  },
  {
   "t0": 22.133,
   "t1": 23.293,
   "text": "закончить любое"
  },
  {
   "t0": 23.293,
   "t1": 24.333,
   "text": "дело вместе."
  },
  {
   "t0": 24.333,
   "t1": 24.813,
   "text": "Поэтому"
  },
  {
   "t0": 24.813,
   "t1": 26.293,
   "text": "пиши строчку:"
  },
  {
   "t0": 26.293,
   "t1": 27.533,
   "text": "«Прости, что долго,"
  },
  {
   "t0": 27.533,
   "t1": 28.333,
   "text": "я тут»."
  },
  {
   "t0": 28.333,
   "t1": 29.733,
   "text": "Я отправил строчку,"
  },
  {
   "t0": 29.733,
   "t1": 30.293,
   "text": "а в ответ"
  },
  {
   "t0": 30.293,
   "t1": 31.48,
   "text": "сердечко."
  }
 ]
}