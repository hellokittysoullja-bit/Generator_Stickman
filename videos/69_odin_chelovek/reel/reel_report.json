 "captions": [
  {
   "t0": 0.0,
   "t1": 0.493,
   "text": "Всем ответил,"
  },
  {
   "t0": 0.493,
   "t1": 1.8,
   "text": "кроме одного?"
  },
  {
   "t0": 1.8,
   "t1": 2.755,
   "text": "Ты пишешь"
  },
  {
   "t0": 2.755,
   "t1": 3.72,
   "text": "всем в чатах,"
  },
  {
   "t0": 3.72,
   "t1": 4.827,
   "text": "но одно сообщение"
  },
  {
   "t0": 4.827,
   "t1": 5.987,
   "text": "висит неделю."
  },
  {
   "t0": 5.987,
