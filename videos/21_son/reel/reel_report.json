 "captions": [
  {
   "t0": 0.0,
   "t1": 0.74,
   "text": "Ты спал 8 часов,"
  },
  {
   "t0": 0.74,
   "t1": 2.733,
   "text": "а утром разбит?"
  },
  {
   "t0": 2.733,
   "t1": 3.133,
   "text": "Дело не"
  },
  {
   "t0": 3.133,
   "t1": 3.933,
   "text": "в сне:"
  },
  {
   "t0": 3.933,
   "t1": 4.973,
   "text": "ты каждую неделю"
  },
  {
   "t0": 4.973,
   "t1": 5.426,
   "text": "летаешь в"
  },
  {
   "t0": 5.426,
   "t1": 6.293,
   "text": "другую страну,"
  },
  {
   "t0": 6.293,
   "t1": 6.493,
   "text": "и в"
  },
  {
   "t0": 6.493,
   "t1": 7.346,
   "text": "конце покажу,"
  },
  {
   "t0": 7.346,
   "t1": 8.733,
   "text": "как тебе вернуться."
  },
  {
   "t0": 8.733,
   "t1": 9.373,
   "text": "В пятницу"
  },
  {
   "t0": 9.373,
   "t1": 10.213,
   "text": "лёг в три,"
  },
  {
   "t0": 10.213,
   "t1": 10.693,
   "text": "в субботу"
  },
  {
   "t0": 10.693,
   "t1": 11.853,
   "text": "встал к обеду,"
  },
  {
   "t0": 11.853,
