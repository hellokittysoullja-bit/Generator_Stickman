 "captions": [
  {
   "t0": 0.0,
   "t1": 1.719,
   "text": "Пашешь, а итог ноль?"
  },
  {
   "t0": 1.719,
   "t1": 3.079,
   "text": "Бегаешь по мелочам,"
  },
  {
   "t0": 3.079,
   "t1": 3.879,
   "text": "а до главного"
  },
  {
   "t0": 3.879,
   "t1": 5.079,
   "text": "руки не дошли."
  },
  {
   "t0": 5.079,
   "t1": 5.559,
   "text": "Покажу,"
  },
  {
   "t0": 5.559,
   "t1": 6.439,
   "text": "как сдвинуть его"
  },
  {
   "t0": 6.439,
   "t1": 7.719,
   "text": "за две минуты."
  },
  {
   "t0": 7.719,
   "t1": 8.439,
   "text": "Я так ответил"
  },
  {
   "t0": 8.439,
   "t1": 9.639,
   "text": "на сорок сообщений,"
  },
  {
   "t0": 9.639,
   "t1": 10.039,
   "text": "а свой"
  },
  {
   "t0": 10.039,
   "t1": 11.399,
   "text": "рассказ не открыл."
  },
  {
   "t0": 11.399,
   "t1": 12.519,
   "text": "В исследовании Чжу"
  },
  {
   "t0": 12.519,
   "t1": 13.319,
   "text": "люди хватали"
  },
  {
