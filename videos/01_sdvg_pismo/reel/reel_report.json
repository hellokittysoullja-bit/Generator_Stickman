   "t1": 45.061,
   "text": "напиши"
  },
  {
   "t0": 45.061,
   "t1": 45.561,
   "text": "КОТ."
  },
  {
   "t0": 45.561,
   "t1": 46.061,
   "text": "Пришлю,"
  },
