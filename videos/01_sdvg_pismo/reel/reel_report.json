 "captions": [
  {
   "t0": 0.0,
   "t1": 1.65,
   "text": "Боишься его письма?"
  },
  {
   "t0": 1.65,
   "t1": 2.176,
   "text": "Хотя там"
  },
  {
   "t0": 2.176,
   "t1": 3.224,
   "text": "ничего такого нет,"
  },
  {
   "t0": 3.224,
   "t1": 3.724,
   "text": "и ты"
  },
  {
   "t0": 3.724,
   "t1": 4.585,
   "text": "это знаешь."
  },
  {
   "t0": 4.585,
   "t1": 5.232,
   "text": "Третий день"
  },
  {
   "t0": 5.232,
   "t1": 5.997,
   "text": "ходишь вокруг,"
  },
  {
   "t0": 5.997,
   "t1": 6.753,
   "text": "и в груди"
  },
  {
   "t0": 6.753,
   "t1": 7.679,
   "text": "всё сжимается."
  },
  {
   "t0": 7.679,
   "t1": 8.738,
   "text": "Со стороны кажется,"
  },
  {
   "t0": 8.738,
   "t1": 10.379,
   "text": "что тебе плевать."
  },
  {
   "t0": 10.379,
   "t1": 11.084,
   "text": "Тебе страшно,"
  },
  {
   "t0": 11.084,
   "t1": 11.584,
   "text": "что там"
  },
  {
   "t0": 11.584,
   "t1": 13.175,
   "text": "на тебя злятся."
  },
  {
   "t0": 13.175,
   "t1": 13.675,
   "text": "И чем"
  },
  {
   "t0": 13.675,
   "t1": 14.734,
   "text": "дольше молчишь, тем"
  },
  {
   "t0": 14.734,
   "t1": 16.021,
   "text": "неловче уже отвечать."
  },
  {
   "t0": 16.021,
   "t1": 16.521,
   "text": "Я сам"
  },
  {
   "t0": 16.521,
   "t1": 17.316,
   "text": "так сидел."
  },
  {
   "t0": 17.316,
   "t1": 17.816,
   "text": "Открыл"
  },
  {
   "t0": 17.816,
   "t1": 18.522,
   "text": "одним глазом"
  },
  {
   "t0": 18.522,
   "t1": 19.613,
   "text": "и сразу закрыл."
  },
  {
   "t0": 19.613,
   "t1": 20.554,
   "text": "Открылось, только"
  },
  {
   "t0": 20.554,
   "t1": 21.613,
   "text": "когда рядом кто-то"
  },
  {
   "t0": 21.613,
   "t1": 22.369,
   "text": "сел и молча"
  },
  {
   "t0": 22.369,
   "t1": 23.23,
   "text": "делал своё."
  },
  {
   "t0": 23.23,
   "t1": 23.73,
   "text": "А там"
  },
  {
   "t0": 23.73,
   "t1": 24.377,
   "text": "две строчки,"
  },
  {
   "t0": 24.377,
   "t1": 24.877,
   "text": "и он"
  },
  {
   "t0": 24.877,
   "t1": 25.969,
   "text": "даже не злился."
  },
  {
   "t0": 25.969,
   "t1": 26.856,
   "text": "Мне тоже одному"
  },
  {
   "t0": 26.856,
   "t1": 27.847,
   "text": "не начинается."
  },
  {
   "t0": 27.847,
   "t1": 28.73,
   "text": "Можешь посидеть"
  },
  {
   "t0": 28.73,
   "t1": 29.286,
   "text": "со мной,"
  },
  {
   "t0": 29.286,
   "t1": 30.443,
   "text": "если тебе сложно."
  },
  {
   "t0": 30.443,
   "t1": 32.069,
   "text": "Это бесплатно."
  },
  {
   "t0": 32.069,
   "t1": 32.569,
   "text": "А ты"
  },
  {
   "t0": 32.569,
   "t1": 33.735,
   "text": "всё ещё…"
  }
 ]
}