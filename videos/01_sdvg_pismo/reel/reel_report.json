 "captions": [
  {
   "t0": 0.0,
   "t1": 0.783,
   "text": "3 дня."
  },
  {
   "t0": 0.783,
   "t1": 1.65,
   "text": "Одно письмо."
  },
  {
   "t0": 1.65,
   "t1": 2.238,
   "text": "Ответить —"
  },
  {
   "t0": 2.238,
   "t1": 3.034,
   "text": "пять минут."
  },
  {
   "t0": 3.034,
   "t1": 3.79,
   "text": "А ты ходишь"
  },
  {
   "t0": 3.79,
   "t1": 4.437,
   "text": "вокруг него"
  },
  {
   "t0": 4.437,
   "t1": 5.067,
   "text": "кругами."
  },
  {
   "t0": 5.067,
   "t1": 5.75,
   "text": "Знакомо?"
  },
  {
   "t0": 5.75,
   "t1": 6.515,
   "text": "Есть хитрость"
  },
  {
   "t0": 6.515,
   "t1": 7.606,
   "text": "на две минуты."
  },
  {
   "t0": 7.606,
   "t1": 8.194,
   "text": "Чем дольше"
  },
  {
   "t0": 8.194,
   "t1": 8.694,
   "text": "ждёшь,"
  },
  {
   "t0": 8.694,
   "t1": 9.282,
   "text": "тем письмо"
  },
  {
   "t0": 9.282,
   "t1": 9.978,
   "text": "тяжелее."
  },
  {
   "t0": 9.978,
   "t1": 10.8,
   "text": "К нему липнут"
  },
  {
   "t0": 10.8,
   "t1": 11.891,
   "text": "стыд и тревога."
  },
  {
   "t0": 11.891,
   "t1": 12.774,
   "text": "Психиатр Уильям"
  },
  {
   "t0": 12.774,
   "t1": 13.274,
   "text": "Додсон"
  },
  {
   "t0": 13.274,
   "t1": 13.803,
   "text": "объясняет"
  },
  {
   "t0": 13.803,
   "t1": 14.433,
   "text": "почему."
  },
  {
   "t0": 14.433,
   "t1": 15.124,
   "text": "Мозг с СДВГ"
  },
  {
   "t0": 15.124,
   "t1": 15.654,
   "text": "заводится"
  },
  {
   "t0": 15.654,
   "t1": 16.407,
   "text": "от интереса,"
  },
  {
   "t0": 16.407,
   "t1": 16.907,
   "text": "а не"
  },
  {
   "t0": 16.907,
   "t1": 17.768,
   "text": "от важности."
  },
  {
   "t0": 17.768,
   "t1": 18.356,
   "text": "Открываешь"
  },
  {
   "t0": 18.356,
   "t1": 19.026,
   "text": "почту…"
  },
  {
   "t0": 19.026,
   "t1": 19.943,
   "text": "и читаешь всё,"
  },
  {
   "t0": 19.943,
   "t1": 21.304,
   "text": "кроме него."
  },
  {
   "t0": 21.304,
   "t1": 22.1,
   "text": "Вот хитрость."
  },
  {
   "t0": 22.1,
   "t1": 22.688,
   "text": "Договорись"
  },
  {
   "t0": 22.688,
   "t1": 23.512,
   "text": "только открыть"
  },
  {
   "t0": 23.512,
   "t1": 24.077,
   "text": "письмо."
  },
  {
   "t0": 24.077,
   "t1": 24.783,
   "text": "Две минуты —"
  },
