  },
  {
   "t0": 38.623,
   "t1": 39.353,
   "text": "Не крик."
  },
  {
   "t0": 39.353,
   "t1": 40.214,
   "text": "Не проверки."
  },
  {
   "t0": 40.214,
   "t1": 41.075,
   "text": "Просто рядом."
  },
  {
   "t0": 41.075,
   "t1": 41.897,
   "text": "Дело за тебя"
  },
  {
   "t0": 41.897,
   "t1": 42.758,
   "text": "не сделаю."
  },
  {
   "t0": 42.758,
   "t1": 43.349,
   "text": "Тут нечего"
