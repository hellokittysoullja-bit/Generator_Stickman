 "captions": [
  {
   "t0": 0.0,
   "t1": 1.65,
   "text": "Другу молчишь 3 дня."
  },
  {
   "t0": 1.65,
   "t1": 2.69,
   "text": "Курьеру отвечаешь"
  },
  {
   "t0": 2.69,
   "t1": 3.81,
   "text": "за секунду."
  },
  {
   "t0": 3.81,
   "t1": 4.29,
   "text": "Тебе не"
  },
  {
   "t0": 4.29,
   "t1": 5.41,
   "text": "всё равно."
  },
  {
   "t0": 5.41,
   "t1": 6.69,
   "text": "Чем роднее человек,"
  },
  {
   "t0": 6.69,
   "t1": 7.57,
   "text": "тем страшнее"
  },
  {
   "t0": 7.57,
   "t1": 8.93,
   "text": "ответить не так."
  },
  {
   "t0": 8.93,
   "t1": 9.303,
   "text": "У меня"
  },
  {
   "t0": 9.303,
   "t1": 10.29,
   "text": "тоже так."
  },
  {
   "t0": 10.29,
   "t1": 11.25,
   "text": "Хожу вокруг,"
  },
  {
   "t0": 11.25,
   "t1": 11.61,
   "text": "в груди"
  },
  {
   "t0": 11.61,
   "t1": 12.81,
   "text": "всё сжимается,"
  },
  {
   "t0": 12.81,
   "t1": 13.09,
   "text": "а там"
  },
  {
   "t0": 13.09,
   "t1": 14.61,
   "text": "ничего такого нет."
  },
  {
   "t0": 14.61,
   "t1": 15.89,
   "text": "Чем дольше молчишь,"
  },
  {
   "t0": 15.89,
   "t1": 17.87,
   "text": "тем неловче отвечать."
  },
  {
   "t0": 17.87,
   "t1": 18.937,
   "text": "Со стороны кажется,"
  },
  {
   "t0": 18.937,
   "t1": 20.73,
   "text": "что тебе плевать,"
  },
  {
   "t0": 20.73,
   "t1": 21.183,
   "text": "и друг"
  },
  {
   "t0": 21.183,
   "t1": 22.41,
   "text": "так и думает."
  },
  {
   "t0": 22.41,
   "t1": 22.97,
   "text": "Я открывал"
  },
  {
   "t0": 22.97,
   "t1": 23.49,
   "text": "чат одним"
  },
  {
   "t0": 23.49,
   "t1": 25.13,
   "text": "глазом и закрывал."
  },
  {
   "t0": 25.13,
   "t1": 25.97,
   "text": "Ответил, только"
  },
  {
   "t0": 25.97,
   "t1": 26.89,
   "text": "когда рядом кто-то"
  },
  {
   "t0": 26.89,
   "t1": 28.49,
   "text": "молча делал своё."
  },
  {
   "t0": 28.49,
   "t1": 29.37,
   "text": "А он:"
  },
  {
   "t0": 29.37,
   "t1": 30.25,
   "text": "«Я сам забыл,"
  },
  {
   "t0": 30.25,
   "t1": 31.29,
   "text": "ты как?»"
  },
  {
   "t0": 31.29,
   "t1": 32.41,
   "text": "Напиши в комментах,"
  },
  {
   "t0": 32.41,
   "t1": 32.81,
   "text": "что у"
  },
  {
   "t0": 32.81,
   "t1": 33.663,
   "text": "тебя вызывает"
  },
  {
   "t0": 33.663,
   "t1": 34.81,
   "text": "такой ступор."
  },
  {
   "t0": 34.81,
   "t1": 35.45,
   "text": "Скажу, что"
  },
  {
   "t0": 35.45,
   "t1": 36.45,
   "text": "это за ловушка,"
  },
  {
   "t0": 36.45,
   "t1": 38.14,
   "text": "и посижу рядом."
  },
  {
   "t0": 38.14,
   "t1": 39.447,
   "text": "А то опять…"
  }
 ]
}