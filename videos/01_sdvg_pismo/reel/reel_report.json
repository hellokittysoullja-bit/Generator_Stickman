  },
  {
   "t0": 28.902,
   "t1": 29.763,
   "text": "Одна строчка."
  },
  {
   "t0": 29.763,
   "t1": 30.289,
   "text": "Написал:"
  },
  {
   "t0": 30.289,
   "t1": 30.789,
   "text": "«Прости,"
  },
  {
   "t0": 30.789,
