 "captions": [
  {
   "t0": 0.0,
   "t1": 0.936,
   "text": "Листаешь вместо"
  },
  {
   "t0": 0.936,
   "t1": 1.65,
   "text": "дела."
  },
  {
   "t0": 1.65,
   "t1": 2.445,
   "text": "Я тоже."
  },
  {
   "t0": 2.445,
   "t1": 3.267,
   "text": "Пока не нашёл"
  },
  {
   "t0": 3.267,
   "t1": 3.767,
   "text": "ход."
  },
  {
   "t0": 3.767,
   "t1": 4.473,
   "text": "Письмо ждало"
  },
  {
   "t0": 4.473,
   "t1": 5.269,
   "text": "третий день."
  },
  {
   "t0": 5.269,
   "t1": 5.975,
   "text": "А ответить —"
  },
  {
   "t0": 5.975,
   "t1": 6.771,
   "text": "пять минут."
  },
  {
   "t0": 6.771,
   "t1": 7.297,
   "text": "И это"
  },
  {
   "t0": 7.297,
   "t1": 8.028,
   "text": "не лень."
  },
  {
   "t0": 8.028,
   "t1": 8.88,
   "text": "Чем дольше жду,"
  },
  {
   "t0": 8.88,
   "t1": 9.468,
   "text": "тем письмо"
  },
  {
   "t0": 9.468,
   "t1": 10.164,
   "text": "тяжелее."
  },
  {
   "t0": 10.164,
   "t1": 10.985,
   "text": "К нему липнут"
  },
  {
   "t0": 10.985,
   "t1": 12.077,
   "text": "стыд и тревога."
  },
  {
   "t0": 12.077,
   "t1": 12.959,
   "text": "Психиатр Уильям"
  },
  {
   "t0": 12.959,
   "t1": 13.842,
   "text": "Додсон объяснил:"
  },
  {
   "t0": 13.842,
   "t1": 14.533,
   "text": "мозг с СДВГ"
  },
  {
   "t0": 14.533,
   "t1": 15.062,
   "text": "заводится"
  },
  {
   "t0": 15.062,
   "t1": 15.815,
   "text": "от интереса,"
  },
  {
   "t0": 15.815,
   "t1": 16.315,
   "text": "а не"
  },
  {
   "t0": 16.315,
   "t1": 17.176,
   "text": "от важности."
  },
  {
   "t0": 17.176,
   "t1": 18.372,
   "text": "Я открыл почту…"
  },
  {
   "t0": 18.372,
   "t1": 19.789,
   "text": "и прочитал всё,"
  },
  {
   "t0": 19.789,
   "t1": 20.65,
   "text": "кроме него."
  },
  {
   "t0": 20.65,
   "t1": 21.15,
   "text": "И вот"
  },
  {
   "t0": 21.15,
   "t1": 21.881,
   "text": "мой ход."
  },
  {
   "t0": 21.881,
   "t1": 22.528,
   "text": "Договорился"
  },
  {
   "t0": 22.528,
   "t1": 23.389,
   "text": "только открыть."
  },
  {
   "t0": 23.389,
   "t1": 24.095,
   "text": "Две минуты —"
  },
  {
   "t0": 24.095,
   "t1": 25.186,
   "text": "и можно бросить."
  },
  {
   "t0": 25.186,
   "t1": 25.982,
   "text": "Не бросил."
  },
  {
   "t0": 25.982,
   "t1": 26.688,
   "text": "Дальше пошло"
  },
  {
   "t0": 26.688,
   "t1": 27.254,
   "text": "само."
  },
  {
   "t0": 27.254,
   "t1": 28.01,
   "text": "А у тебя"
  },
  {
   "t0": 28.01,
   "t1": 29.367,
   "text": "какое дело"
  },
  {
   "t0": 29.367,
   "t1": 29.984,
   "text": "висит?"
  },
  {
   "t0": 29.984,
   "t1": 30.845,
   "text": "Я Напарник."
  },
  {
   "t0": 30.845,
   "t1": 31.61,
   "text": "Одному скучно"
  },
  {
   "t0": 31.61,
   "t1": 32.241,
   "text": "работать."
  },
  {
   "t0": 32.241,
   "t1": 32.741,
   "text": "Посидишь"
  },
  {
   "t0": 32.741,
   "t1": 33.758,
   "text": "рядом?"
  },
  {
   "t0": 33.758,
   "t1": 34.349,
   "text": "Я ничего"
  },
  {
   "t0": 34.349,
   "t1": 35.145,
   "text": "не спрошу."
  },
  {
   "t0": 35.145,
   "t1": 35.967,
   "text": "Дело за тебя"
  },
  {
   "t0": 35.967,
   "t1": 36.828,
   "text": "не сделаю."
  },
  {
   "t0": 36.828,
   "t1": 37.919,
   "text": "Но начать легче."
  },
  {
   "t0": 37.919,
   "t1": 38.566,
   "text": "Залипнешь —"
  },
  {
   "t0": 38.566,
   "t1": 39.066,
   "text": "напиши"
  },
  {
   "t0": 39.066,
   "t1": 39.566,
   "text": "КОТ."
  },
  {
   "t0": 39.566,
   "t1": 40.066,
   "text": "Пришлю,"
  },
  {
   "t0": 40.066,
   "t1": 41.092,
   "text": "где я сижу."
  },
  {
   "t0": 41.092,
   "t1": 41.844,
   "text": "Покажи тому,"
  },
  {
   "t0": 41.844,
   "t1": 42.373,
   "text": "кто зовёт"
  },
  {
   "t0": 42.373,
   "t1": 43.234,
   "text": "это ленью."
  },
  {
   "t0": 43.234,
   "t1": 43.991,
   "text": "А письмо всё"
  },
  {
   "t0": 43.991,
   "t1": 44.491,
   "text": "ждёт."
  },
  {
   "t0": 44.491,
   "t1": 45.197,
   "text": "Пять минут —"
  },
  {
   "t0": 45.197,
   "t1": 46.133,
   "text": "вместе?"
  }
 ]
