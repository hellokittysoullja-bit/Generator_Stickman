   "text": "молча делал своё."
  },
  {
   "t0": 27.29,
   "t1": 28.01,
   "text": "А он:"
  },
  {
   "t0": 28.01,
   "t1": 28.89,
   "text": "«Я сам забыл,"
  },
  {
   "t0": 28.89,
   "t1": 29.61,
   "text": "ты как?»"
  },
  {
   "t0": 29.61,
   "t1": 30.73,
   "text": "Напиши в комментах,"
  },
  {
   "t0": 30.73,
   "t1": 31.05,
   "text": "что у"
  },
  {
   "t0": 31.05,
   "t1": 31.89,
   "text": "тебя вызывает"
  },
  {
   "t0": 31.89,
   "t1": 32.97,
   "text": "такой ступор."
  },
  {
   "t0": 32.97,
   "t1": 33.53,
   "text": "Если тебе"
  },
  {
   "t0": 33.53,
   "t1": 34.29,
   "text": "тоже трудно"
