   "text": "Ленивые себя"
  },
  {
   "t0": 0.775,
   "t1": 1.65,
   "text": "не грызут."
  },
  {
   "t0": 1.65,
   "t1": 2.676,
   "text": "А я грызу."
  },
  {
   "t0": 2.676,
   "t1": 3.498,
   "text": "Пока не нашёл"
  },
  {
   "t0": 3.498,
   "t1": 3.998,
   "text": "ход."
  },
  {
   "t0": 3.998,
   "t1": 4.645,
   "text": "Третий день"
  },
  {
   "t0": 4.645,
   "t1": 5.506,
   "text": "из-за письма."
  },
  {
   "t0": 5.506,
   "t1": 6.328,
   "text": "А там ничего"
  },
  {
   "t0": 6.328,
   "t1": 7.189,
   "text": "такого нет."
  },
  {
   "t0": 7.189,
   "t1": 8.011,
   "text": "В голове я"
  },
  {
   "t0": 8.011,
   "t1": 8.937,
   "text": "уже ответил."
  },
  {
   "t0": 8.937,
   "t1": 9.525,
   "text": "Чем дольше"
  },
  {
   "t0": 9.525,
   "t1": 10.025,
   "text": "молчу,"
  },
  {
   "t0": 10.025,
   "t1": 10.886,
   "text": "тем неловче."
  },
  {
   "t0": 10.886,
   "t1": 11.868,
   "text": "Друг уже думает,"
  },
  {
   "t0": 11.868,
   "t1": 12.56,
   "text": "что мне всё"
  },
  {
   "t0": 12.56,
   "t1": 13.125,
   "text": "равно."
  },
  {
   "t0": 13.125,
   "t1": 14.051,
