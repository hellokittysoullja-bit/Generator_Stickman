 "captions": [
  {
   "t0": 0.0,
   "t1": 1.65,
   "text": "Тебе же плевать, да?"
  },
  {
   "t0": 1.65,
   "t1": 2.567,
   "text": "Он так думает,"
  },
  {
   "t0": 2.567,
   "t1": 3.067,
   "text": "а ты"
  },
  {
   "t0": 3.067,
   "t1": 3.891,
   "text": "неделю боишься"
  },
  {
   "t0": 3.891,
   "t1": 5.047,
   "text": "открыть его письмо."
  },
  {
   "t0": 5.047,
   "t1": 5.87,
   "text": "Ходишь кругами,"
  },
  {
   "t0": 5.87,
   "t1": 6.37,
   "text": "а там"
  },
  {
   "t0": 6.37,
   "t1": 7.166,
   "text": "две строчки."
  },
  {
   "t0": 7.166,
   "t1": 7.853,
   "text": "Ты думаешь,"
  },
  {
   "t0": 7.853,
   "t1": 8.714,
   "text": "что ленивый."
  },
  {
   "t0": 8.714,
   "t1": 9.479,
   "text": "Ленивому было"
  },
  {
   "t0": 9.479,
   "t1": 10.275,
   "text": "бы плевать."
  },
  {
   "t0": 10.275,
   "t1": 10.981,
   "text": "Тебе страшно,"
  },
  {
   "t0": 10.981,
   "t1": 11.745,
   "text": "и мозг прячет"
  },
  {
   "t0": 11.745,
   "t1": 12.902,
   "text": "тебя в телефон."
  },
  {
   "t0": 12.902,
   "t1": 13.402,
   "text": "Я сам"
  },
  {
   "t0": 13.402,
   "t1": 14.167,
   "text": "три дня сидел"
  },
  {
   "t0": 14.167,
   "t1": 15.259,
   "text": "над таким письмом."
  },
  {
   "t0": 15.259,
   "t1": 15.759,
   "text": "Помнишь,"
  },
  {
   "t0": 15.759,
   "t1": 16.583,
   "text": "когда начинать"
  },
  {
   "t0": 16.583,
   "t1": 18.096,
   "text": "было легко?"
  },
  {
   "t0": 18.096,
   "t1": 19.213,
   "text": "Когда кто-то просто"
  },
  {
   "t0": 19.213,
   "t1": 20.073,
   "text": "сидел рядом."
  },
  {
   "t0": 20.073,
   "t1": 20.573,
   "text": "Но звать"
  },
  {
   "t0": 20.573,
   "t1": 21.338,
   "text": "маму посидеть"
  },
  {
   "t0": 21.338,
   "t1": 21.968,
   "text": "неловко."
  },
  {
   "t0": 21.968,
   "t1": 22.468,
   "text": "Я дал"
  },
  {
   "t0": 22.468,
   "t1": 23.451,
   "text": "себе две минуты,"
  },
  {
   "t0": 23.451,
   "t1": 23.977,
   "text": "и можно"
  },
  {
   "t0": 23.977,
   "t1": 24.838,
   "text": "было бросить."
  },
  {
   "t0": 24.838,
   "t1": 25.459,
   "text": "Открыл, а"
  },
  {
   "t0": 25.459,
   "t1": 26.047,
   "text": "там правда"
  },
  {
   "t0": 26.047,
   "t1": 26.843,
   "text": "две строчки."
  },
  {
   "t0": 26.843,
   "t1": 27.695,
   "text": "Он не злился,"
  },
  {
   "t0": 27.695,
   "t1": 28.426,
   "text": "он ждал."
  },
  {
   "t0": 28.426,
   "t1": 29.309,
   "text": "Можешь посидеть"
  },
  {
   "t0": 29.309,
   "t1": 29.866,
   "text": "со мной,"
  },
  {
   "t0": 29.866,
   "t1": 30.848,
   "text": "если тебе сложно,"
  },
  {
   "t0": 30.848,
   "t1": 32.374,
   "text": "это бесплатно."
  },
  {
   "t0": 32.374,
   "t1": 33.771,
   "text": "Твой тоже ждёт."
  }
 ]
}