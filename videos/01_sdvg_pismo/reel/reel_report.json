  },
  {
   "t0": 11.21,
   "t1": 12.37,
   "text": "всё сжимается,"
  },
  {
   "t0": 12.37,
   "t1": 12.81,
   "text": "а там"
  },
  {
   "t0": 12.81,
   "t1": 14.13,
   "text": "ничего такого нет."
  },
  {
   "t0": 14.13,
   "t1": 15.33,
   "text": "Чем дольше молчишь,"
  },
  {
   "t0": 15.33,
   "t1": 17.23,
   "text": "тем неловче отвечать."
  },
  {
   "t0": 17.23,
   "t1": 18.19,
   "text": "Со стороны кажется,"
  },
  {
   "t0": 18.19,
   "t1": 20.01,
   "text": "что тебе плевать,"
  },
  {
   "t0": 20.01,
   "t1": 20.463,
   "text": "и друг"
  },
  {
   "t0": 20.463,
   "t1": 21.45,
   "text": "так и думает."
  },
  {
   "t0": 21.45,
   "t1": 22.09,
   "text": "Я открывал"
  },
  {
   "t0": 22.09,
   "t1": 22.57,
   "text": "чат одним"
  },
  {
   "t0": 22.57,
   "t1": 24.01,
   "text": "глазом и закрывал."
  },
  {
   "t0": 24.01,
   "t1": 24.89,
   "text": "Ответил, только"
  },
  {
   "t0": 24.89,
   "t1": 25.89,
   "text": "когда рядом кто-то"
  },
  {
   "t0": 25.89,
