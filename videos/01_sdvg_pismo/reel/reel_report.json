  },
  {
   "t0": 15.19,
   "t1": 16.073,
   "text": "Психиатр Уильям"
  },
  {
   "t0": 16.073,
   "t1": 16.955,
   "text": "Додсон объяснил:"
  },
  {
   "t0": 16.955,
   "t1": 17.646,
