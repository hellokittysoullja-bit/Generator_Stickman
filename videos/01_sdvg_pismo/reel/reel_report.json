 "captions": [
  {
   "t0": 0.0,
   "t1": 1.65,
   "text": "Другу молчишь 3 дня."
  },
  {
   "t0": 1.65,
   "t1": 2.65,
   "text": "Курьеру отвечаешь"
  },
  {
   "t0": 2.65,
   "t1": 3.511,
   "text": "за секунду."
  },
  {
   "t0": 3.511,
   "t1": 4.037,
   "text": "Тебе не"
  },
  {
   "t0": 4.037,
   "t1": 4.832,
   "text": "всё равно."
  },
  {
   "t0": 4.832,
   "t1": 5.891,
   "text": "Чем роднее человек,"
  },
  {
   "t0": 5.891,
   "t1": 6.597,
   "text": "тем страшнее"
  },
  {
   "t0": 6.597,
   "t1": 7.689,
   "text": "ответить не так."
  },
  {
   "t0": 7.689,
   "t1": 8.215,
   "text": "У меня"
  },
  {
   "t0": 8.215,
   "t1": 9.01,
   "text": "тоже так."
  },
  {
   "t0": 9.01,
   "t1": 9.697,
   "text": "Хожу вокруг,"
  },
  {
   "t0": 9.697,
   "t1": 10.224,
   "text": "в груди"
  },
  {
   "t0": 10.224,
   "t1": 10.988,
   "text": "всё сжимается,"
  },
  {
   "t0": 10.988,
   "t1": 11.488,
   "text": "а там"
  },
  {
   "t0": 11.488,
   "t1": 12.709,
   "text": "ничего такого нет."
  },
  {
   "t0": 12.709,
   "t1": 13.768,
   "text": "Чем дольше молчишь,"
  },
  {
   "t0": 13.768,
   "t1": 15.689,
   "text": "тем неловче отвечать."
  },
  {
   "t0": 15.689,
   "t1": 16.748,
   "text": "Со стороны кажется,"
  },
  {
   "t0": 16.748,
   "t1": 18.566,
   "text": "что тебе плевать,"
  },
  {
   "t0": 18.566,
   "t1": 19.066,
   "text": "и друг"
  },
  {
   "t0": 19.066,
   "t1": 20.157,
   "text": "так и думает."
  },
  {
   "t0": 20.157,
   "t1": 20.748,
   "text": "Я открывал"
  },
  {
   "t0": 20.748,
   "t1": 21.277,
   "text": "чат одним"
  },
  {
   "t0": 21.277,
   "t1": 22.434,
   "text": "глазом и закрывал."
  },
  {
   "t0": 22.434,
   "t1": 23.258,
   "text": "Ответил, только"
  },
  {
   "t0": 23.258,
   "t1": 24.317,
   "text": "когда рядом кто-то"
  },
  {
   "t0": 24.317,
   "t1": 25.473,
   "text": "молча делал своё."
  },
  {
   "t0": 25.473,
   "t1": 26.099,
   "text": "А он:"
  },
  {
   "t0": 26.099,
   "t1": 26.952,
   "text": "«Я сам забыл,"
  },
  {
   "t0": 26.952,
   "t1": 27.734,
   "text": "ты как?»"
  },
  {
   "t0": 27.734,
   "t1": 28.621,
   "text": "Мне тоже одному"
  },
  {
   "t0": 28.621,
   "t1": 29.613,
   "text": "не начинается."
  },
  {
   "t0": 29.613,
   "t1": 30.495,
   "text": "Можешь посидеть"
  },
  {
   "t0": 30.495,
   "t1": 31.052,
   "text": "со мной,"
  },
  {
   "t0": 31.052,
   "t1": 32.208,
   "text": "если тебе сложно."
  },
  {
   "t0": 32.208,
   "t1": 33.834,
   "text": "Это бесплатно."
  },
  {
   "t0": 33.834,
   "t1": 35.232,
   "text": "А то опять…"
  }
 ]
}