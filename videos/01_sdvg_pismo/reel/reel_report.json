 "captions": [
  {
   "t0": 0.0,
   "t1": 1.65,
   "text": "«Тебе плевать.»"
  },
  {
   "t0": 1.65,
   "t1": 2.15,
   "text": "А ты"
  },
  {
   "t0": 2.15,
   "t1": 2.797,
   "text": "третий день"
  },
  {
   "t0": 2.797,
   "t1": 3.444,
   "text": "думаешь про"
  },
  {
   "t0": 3.444,
   "t1": 4.266,
   "text": "его письмо и"
  },
  {
   "t0": 4.266,
   "t1": 5.357,
   "text": "не можешь открыть."
  },
  {
   "t0": 5.357,
   "t1": 6.122,
   "text": "Ходишь вокруг,"
  },
  {
   "t0": 6.122,
   "t1": 6.879,
   "text": "и в груди"
  },
  {
   "t0": 6.879,
   "t1": 7.805,
   "text": "всё сжимается."
  },
  {
   "t0": 7.805,
   "t1": 8.922,
   "text": "Кому плевать, вокруг"
  },
  {
   "t0": 8.922,
   "t1": 10.614,
   "text": "писем не ходит."
  },
  {
   "t0": 10.614,
   "t1": 11.32,
   "text": "Тебе страшно,"
  },
  {
   "t0": 11.32,
   "t1": 11.82,
   "text": "что там"
  },
  {
   "t0": 11.82,
   "t1": 13.412,
   "text": "на тебя злятся."
  },
  {
   "t0": 13.412,
   "t1": 13.912,
   "text": "И чем"
  },
  {
   "t0": 13.912,
   "t1": 14.971,
   "text": "дольше молчишь, тем"
  },
  {
   "t0": 14.971,
   "t1": 16.258,
   "text": "неловче уже отвечать."
  },
  {
   "t0": 16.258,
   "t1": 16.758,
   "text": "Я сам"
  },
  {
   "t0": 16.758,
   "t1": 17.554,
   "text": "так сидел."
  },
  {
   "t0": 17.554,
   "t1": 18.054,
   "text": "Открыл"
  },
  {
   "t0": 18.054,
   "t1": 18.76,
   "text": "одним глазом"
  },
  {
   "t0": 18.76,
   "t1": 19.852,
   "text": "и сразу закрыл."
  },
  {
   "t0": 19.852,
   "t1": 20.793,
   "text": "Открылось, только"
  },
  {
   "t0": 20.793,
   "t1": 21.852,
   "text": "когда рядом кто-то"
  },
  {
   "t0": 21.852,
   "t1": 22.608,
   "text": "сел и молча"
  },
  {
   "t0": 22.608,
   "t1": 23.469,
   "text": "делал своё."
  },
  {
   "t0": 23.469,
   "t1": 23.969,
   "text": "А там"
  },
  {
   "t0": 23.969,
   "t1": 24.616,
   "text": "две строчки,"
  },
  {
   "t0": 24.616,
   "t1": 25.116,
   "text": "и он"
  },
  {
   "t0": 25.116,
   "t1": 26.207,
   "text": "даже не злился."
  },
  {
   "t0": 26.207,
   "t1": 27.094,
   "text": "Мне тоже одному"
  },
  {
   "t0": 27.094,
   "t1": 28.085,
   "text": "не начинается."
  },
  {
   "t0": 28.085,
   "t1": 28.967,
   "text": "Можешь посидеть"
  },
  {
   "t0": 28.967,
   "t1": 29.523,
   "text": "со мной,"
  },
  {
   "t0": 29.523,
   "t1": 30.68,
   "text": "если тебе сложно."
  },
  {
   "t0": 30.68,
   "t1": 32.306,
   "text": "Это бесплатно."
  },
  {
   "t0": 32.306,
   "t1": 33.093,
   "text": "А тот, кто"
  },
  {
   "t0": 33.093,
   "t1": 34.152,
   "text": "ждёт твоего ответа,"
  },
  {
   "t0": 34.152,
   "t1": 35.154,
   "text": "думает:"
  }
 ]
}