   "t1": 30.195,
   "text": "какое письмо"
  },
  {
   "t0": 30.195,
   "t1": 30.813,
   "text": "висит?"
  },
  {
   "t0": 30.813,
   "t1": 31.673,
   "text": "Я Напарник."
  },
  {
   "t0": 31.673,
   "t1": 32.262,
   "text": "Захочешь —"
  },
  {
   "t0": 32.262,
   "t1": 33.188,
   "text": "посижу рядом."
  },
  {
   "t0": 33.188,
   "t1": 34.01,
   "text": "Дело за тебя"
  },
  {
   "t0": 34.01,
   "t1": 34.871,
   "text": "не сделаю."
  },
  {
   "t0": 34.871,
   "t1": 35.962,
   "text": "Но начать легче."
  },
  {
   "t0": 35.962,
   "t1": 36.609,
   "text": "Когда снова"
  },
  {
   "t0": 36.609,
   "t1": 37.256,
   "text": "залипнешь —"
  },
  {
   "t0": 37.256,
   "t1": 38.012,
   "text": "я в шапке"
  },
  {
   "t0": 38.012,
   "t1": 38.642,
   "text": "профиля."
  },
  {
   "t0": 38.642,
   "t1": 39.273,
   "text": "Бесплатно."
  },
  {
   "t0": 39.273,
   "t1": 39.979,
   "text": "Отправь тому,"
  },
