   "t0": 2.81,
   "t1": 3.89,
   "text": "за секунду."
  },
  {
   "t0": 3.89,
   "t1": 4.33,
   "text": "Тебе не"
  },
  {
   "t0": 4.33,
   "t1": 5.33,
   "text": "всё равно."
  },
  {
   "t0": 5.33,
   "t1": 6.69,
   "text": "Чем роднее человек,"
  },
  {
   "t0": 6.69,
   "t1": 7.57,
   "text": "тем страшнее"
  },
  {
   "t0": 7.57,
   "t1": 8.69,
   "text": "ответить не так."
  },
  {
   "t0": 8.69,
   "t1": 9.09,
   "text": "У меня"
  },
  {
   "t0": 9.09,
   "t1": 9.97,
   "text": "тоже так."
  },
  {
   "t0": 9.97,
   "t1": 10.85,
   "text": "Хожу вокруг,"
