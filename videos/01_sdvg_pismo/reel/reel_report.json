  {
   "t0": 17.646,
   "t1": 18.175,
   "text": "заводится"
  },
  {
   "t0": 18.175,
   "t1": 18.927,
   "text": "от интереса,"
  },
  {
   "t0": 18.927,
   "t1": 19.427,
   "text": "а не"
  },
  {
   "t0": 19.427,
   "t1": 20.288,
   "text": "от важности."
  },
  {
   "t0": 20.288,
   "t1": 20.994,
   "text": "Прочитал всю"
  },
  {
   "t0": 20.994,
   "t1": 22.06,
   "text": "почту."
  },
  {
   "t0": 22.06,
   "t1": 22.651,
   "text": "Кроме ТОГО"
  },
  {
   "t0": 22.651,
   "t1": 23.281,
   "text": "САМОГО."
  },
  {
   "t0": 23.281,
   "t1": 23.781,
   "text": "Знаешь,"
  },
  {
   "t0": 23.781,
   "t1": 25.359,
   "text": "что сработало?"
  },
  {
   "t0": 25.359,
   "t1": 26.154,
   "text": "Не воля."
  },
  {
   "t0": 26.154,
