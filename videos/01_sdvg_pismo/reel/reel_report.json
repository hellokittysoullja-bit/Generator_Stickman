  },
  {
   "t0": 36.432,
   "t1": 37.293,
   "text": "Я Напарник."
  },
  {
   "t0": 37.293,
   "t1": 38.058,
   "text": "Вдвоём начать"
  },
  {
   "t0": 38.058,
