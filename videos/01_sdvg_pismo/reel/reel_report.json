 "captions": [
  {
   "t0": 0.0,
   "t1": 1.65,
   "text": "Другу молчишь 3 дня."
  },
  {
   "t0": 1.65,
   "t1": 2.81,
   "text": "Курьеру отвечаешь"
  },
