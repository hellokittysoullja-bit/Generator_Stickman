 "captions": [
  {
   "t0": 0.0,
   "t1": 0.618,
   "text": "Письмо."
  },
  {
   "t0": 0.618,
   "t1": 1.65,
   "text": "День третий."
  },
  {
   "t0": 1.65,
   "t1": 2.238,
   "text": "Ответить —"
  },
  {
   "t0": 2.238,
   "t1": 3.033,
   "text": "пять минут."
  },
  {
   "t0": 3.033,
   "t1": 3.79,
   "text": "А я хожу"
  },
  {
   "t0": 3.79,
   "t1": 4.437,
   "text": "вокруг него"
  },
  {
   "t0": 4.437,
   "t1": 5.068,
   "text": "кругами."
  },
  {
   "t0": 5.068,
   "t1": 5.889,
   "text": "Мне советуют:"
  },
  {
   "t0": 5.889,
   "t1": 6.75,
   "text": "«Просто начни»."
  },
  {
   "t0": 6.75,
   "t1": 7.676,
   "text": "Не работает."
  },
  {
   "t0": 7.676,
   "t1": 8.768,
   "text": "И вот почему."
  },
  {
   "t0": 8.768,
   "t1": 9.62,
   "text": "Чем дольше жду,"
  },
  {
   "t0": 9.62,
   "t1": 10.209,
   "text": "тем письмо"
  },
  {
   "t0": 10.209,
   "t1": 10.905,
   "text": "тяжелее."
  },
  {
   "t0": 10.905,
   "t1": 11.726,
   "text": "К нему липнут"
  },
  {
   "t0": 11.726,
   "t1": 12.818,
   "text": "стыд и тревога."
  },
  {
   "t0": 12.818,
   "t1": 13.7,
   "text": "Психиатр Уильям"
  },
  {
   "t0": 13.7,
   "t1": 14.582,
   "text": "Додсон объяснил:"
  },
  {
   "t0": 14.582,
   "t1": 15.273,
   "text": "мозг с СДВГ"
  },
  {
   "t0": 15.273,
   "t1": 15.803,
   "text": "заводится"
  },
  {
   "t0": 15.803,
   "t1": 16.555,
   "text": "от интереса,"
  },
  {
   "t0": 16.555,
   "t1": 17.055,
   "text": "а не"
  },
  {
   "t0": 17.055,
   "t1": 17.915,
   "text": "от важности."
  },
  {
   "t0": 17.915,
   "t1": 19.111,
   "text": "Я открыл почту…"
  },
  {
   "t0": 19.111,
   "t1": 20.528,
   "text": "и прочитал всё,"
  },
  {
   "t0": 20.528,
   "t1": 21.389,
   "text": "кроме него."
  },
  {
   "t0": 21.389,
   "t1": 22.211,
   "text": "Тогда я нашёл"
  },
  {
   "t0": 22.211,
   "t1": 22.711,
   "text": "ход."
  },
  {
   "t0": 22.711,
   "t1": 23.358,
   "text": "Договорился"
  },
  {
   "t0": 23.358,
   "t1": 24.219,
   "text": "только открыть."
  },
  {
   "t0": 24.219,
   "t1": 24.925,
   "text": "Две минуты —"
