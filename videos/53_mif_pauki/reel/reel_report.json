 "captions": [
  {
   "t0": 0.0,
   "t1": 0.56,
   "text": "Восемь пауков"
  },
  {
   "t0": 0.56,
   "t1": 1.81,
   "text": "за ночь?"
  },
  {
   "t0": 1.81,
   "t1": 1.943,
   "text": "Ты"
  },
  {
   "t0": 1.943,
   "t1": 2.93,
   "text": "наверняка слышал,"
  },
  {
   "t0": 2.93,
   "t1": 3.61,
   "text": "что мы глотаем"
  },
  {
   "t0": 3.61,
   "t1": 4.45,
   "text": "их во сне,"
  },
  {
   "t0": 4.45,
   "t1": 5.29,
   "text": "но это"
  },
  {
   "t0": 5.29,
   "t1": 6.37,
   "text": "неправда."
  },
  {
   "t0": 6.37,
   "t1": 7.61,
   "text": "Я полночи лежал"
  },
  {
   "t0": 7.61,
   "t1": 8.45,
   "text": "и сторожил свой"
  },
  {
   "t0": 8.45,
   "t1": 9.41,
   "text": "открытый рот."
  },
  {
   "t0": 9.41,
   "t1": 10.21,
   "text": "А утром узнал,"
  },
  {
   "t0": 10.21,
   "t1": 11.09,
   "text": "что эту цифру"
  },
  {
   "t0": 11.09,
   "t1": 11.97,
   "text": "никто никогда"
  },
  {
   "t0": 11.97,
   "t1": 12.921,
   "text": "не считал."
  },
  {
   "t0": 12.921,
   "t1": 13.33,
   "text": "Пауку"
  },
  {
   "t0": 13.33,
   "t1": 14.01,
   "text": "незачем лезть"
  },
  {
   "t0": 14.01,
   "t1": 14.93,
   "text": "к спящему:"
  },
  {
   "t0": 14.93,
   "t1": 15.29,
   "text": "мы для"
  },
  {
   "t0": 15.29,
   "t1": 16.21,
   "text": "него огромная,"
  },
  {
   "t0": 16.21,
   "t1": 16.93,
   "text": "тёплая и"
  },
  {
   "t0": 16.93,
   "t1": 17.917,
   "text": "шумная гора,"
  },
  {
   "t0": 17.917,
   "t1": 18.73,
   "text": "от которой лучше"
  },
  {
   "t0": 18.73,
   "t1": 19.943,
   "text": "держаться подальше."
  },
  {
   "t0": 19.943,
   "t1": 20.29,
   "text": "Так что"
  },
  {
   "t0": 20.29,
   "t1": 21.303,
   "text": "спи спокойно,"
  },
  {
   "t0": 21.303,
   "t1": 22.41,
   "text": "а страшилки"
  },
  {
   "t0": 22.41,
   "t1": 22.93,
   "text": "проверяй,"
  },
  {
   "t0": 22.93,
   "t1": 23.73,
   "text": "прежде чем терять"
  },
  {
   "t0": 23.73,
   "t1": 24.85,
   "text": "из-за них сон."
  },
  {
   "t0": 24.85,
   "t1": 25.73,
   "text": "Напиши в комментах,"
  },
  {
   "t0": 25.73,
   "t1": 26.21,
   "text": "в какой"
  },
  {
   "t0": 26.21,
   "t1": 27.01,
   "text": "странный факт"
  },
  {
   "t0": 27.01,
   "t1": 27.53,
   "text": "ты верил"
  },
  {
   "t0": 27.53,
   "t1": 28.503,
   "text": "дольше всех."
  },
  {
   "t0": 28.503,
   "t1": 29.41,
   "text": "А теперь смотри,"
  },
  {
   "t0": 29.41,
   "t1": 29.89,
   "text": "что было"
  },
  {
   "t0": 29.89,
   "t1": 30.53,
   "text": "с моим сном"
  },
  {
   "t0": 30.53,
   "t1": 31.41,
   "text": "дальше."
  },
  {
   "t0": 31.41,
   "t1": 32.05,
   "text": "Я лёг,"
  },
  {
   "t0": 32.05,
   "t1": 32.69,
   "text": "закрыл рот"
  },
  {
   "t0": 32.69,
   "t1": 33.21,
   "text": "только чтобы"
  },
  {
   "t0": 33.21,
   "t1": 33.97,
   "text": "не храпеть,"
  },
  {
   "t0": 33.97,
   "t1": 34.77,
   "text": "и выспался"
  },
  {
   "t0": 34.77,
   "t1": 36.557,
   "text": "впервые за неделю."
  }
 ]
