 "captions": [
  {
   "t0": 0.0,
   "t1": 0.707,
   "text": "Двойки за учёбу?"
  },
  {
   "t0": 0.707,
   "t1": 0.92,
   "text": "Ну ты"
  },
  {
   "t0": 0.92,
   "t1": 2.413,
   "text": "гений?"
  },
  {
   "t0": 2.413,
   "t1": 3.313,
   "text": "Ты слышал это"
  },
  {
   "t0": 3.313,
   "t1": 4.173,
   "text": "про Эйнштейна,"
  },
  {
   "t0": 4.173,
   "t1": 5.08,
   "text": "но двоечником"
  },
  {
   "t0": 5.08,
   "t1": 6.053,
   "text": "он не был."
  },
  {
   "t0": 6.053,
   "t1": 6.866,
   "text": "С детства он"
  },
  {
   "t0": 6.866,
   "t1": 7.893,
   "text": "обгонял весь класс"
  },
  {
   "t0": 7.893,
   "t1": 8.813,
   "text": "в математике."
  },
  {
   "t0": 8.813,
   "t1": 9.666,
   "text": "А слух пошёл"
  },
  {
   "t0": 9.666,
   "t1": 10.813,
   "text": "из газетной заметки"
  },
  {
   "t0": 10.813,
   "t1": 11.853,
   "text": "почти сто лет"
  },
  {
   "t0": 11.853,
   "t1": 14.403,
   "text": "назад."
  },
  {
   "t0": 14.403,
   "t1": 15.019,
   "text": "Миф живёт,"
  },
  {
   "t0": 15.019,
   "t1": 16.553,
   "text": "потому что утешает:"
  },
  {
