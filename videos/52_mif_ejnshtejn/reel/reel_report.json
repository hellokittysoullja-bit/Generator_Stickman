 "captions": [
  {
   "t0": 0.0,
   "t1": 1.81,
   "text": "Двойки, а ты гений?"
  },
  {
   "t0": 1.81,
   "t1": 2.33,
   "text": "Ты слышал"
  },
  {
   "t0": 2.33,
   "t1": 3.41,
   "text": "это про Эйнштейна,"
  },
  {
   "t0": 3.41,
   "t1": 4.29,
   "text": "но двоечником"
  },
  {
   "t0": 4.29,
   "t1": 5.09,
   "text": "он не был."
  },
  {
   "t0": 5.09,
   "t1": 5.73,
   "text": "С детства он"
  },
  {
   "t0": 5.73,
   "t1": 6.81,
   "text": "обгонял весь класс"
  },
  {
   "t0": 6.81,
   "t1": 7.917,
   "text": "в математике."
  },
  {
   "t0": 7.917,
   "t1": 8.57,
   "text": "А слух пошёл"
  },
  {
