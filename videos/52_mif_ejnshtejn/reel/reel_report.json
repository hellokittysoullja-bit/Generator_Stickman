 "captions": [
  {
   "t0": 0.0,
   "t1": 0.707,
   "text": "Двойки за учёбу?"
  },
  {
   "t0": 0.707,
   "t1": 0.96,
   "text": "Но ты"
  },
  {
   "t0": 0.96,
   "t1": 2.68,
   "text": "гений?"
  },
  {
   "t0": 2.68,
   "t1": 3.713,
   "text": "Ты слышал это"
  },
  {
   "t0": 3.713,
   "t1": 4.706,
   "text": "про Эйнштейна,"
  },
  {
   "t0": 4.706,
   "t1": 5.64,
   "text": "но двоечником"
  },
  {
   "t0": 5.64,
   "t1": 6.673,
   "text": "он не был."
  },
  {
   "t0": 6.673,
   "t1": 7.4,
   "text": "С детства он"
  },
  {
   "t0": 7.4,
   "t1": 8.533,
   "text": "обгонял весь класс"
  },
  {
   "t0": 8.533,
   "t1": 9.533,
   "text": "в математике."
  },
  {
   "t0": 9.533,
   "t1": 10.253,
   "text": "А слух пошёл"
  },
  {
   "t0": 10.253,
   "t1": 11.346,
   "text": "из газетной заметки"
  },
  {
   "t0": 11.346,
   "t1": 12.413,
   "text": "почти сто лет"
  },
  {
   "t0": 12.413,
   "t1": 13.523,
   "text": "назад."
  },
  {
   "t0": 13.523,
   "t1": 14.219,
   "text": "Миф живёт,"
  },
  {
   "t0": 14.219,
   "t1": 15.853,
   "text": "потому что утешает:"
  },
  {
