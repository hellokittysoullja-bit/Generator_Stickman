 "captions": [
  {
   "t0": 0.0,
   "t1": 0.64,
   "text": "Двойки за учёбу?"
  },
  {
   "t0": 0.64,
   "t1": 0.86,
   "text": "Но ты"
  },
  {
   "t0": 0.86,
   "t1": 2.706,
   "text": "гений?"
  },
  {
   "t0": 2.706,
   "t1": 3.653,
   "text": "Ты слышал это"
  },
  {
   "t0": 3.653,
   "t1": 4.786,
   "text": "про Эйнштейна,"
  },
  {
   "t0": 4.786,
   "t1": 5.586,
   "text": "но двоечником"
  },
  {
   "t0": 5.586,
   "t1": 6.393,
   "text": "он не был."
  },
  {
   "t0": 6.393,
   "t1": 7.08,
   "text": "С детства он"
  },
  {
   "t0": 7.08,
   "t1": 8.053,
   "text": "обгонял весь класс"
  },
  {
   "t0": 8.053,
   "t1": 9.093,
   "text": "в математике."
  },
  {
   "t0": 9.093,
   "t1": 9.986,
   "text": "А слух пошёл"
  },
  {
   "t0": 9.986,
   "t1": 11.04,
   "text": "из газетной заметки"
  },
  {
   "t0": 11.04,
   "t1": 11.92,
   "text": "почти сто лет"
  },
  {
   "t0": 11.92,
