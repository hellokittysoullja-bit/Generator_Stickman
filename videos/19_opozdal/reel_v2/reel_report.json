 "captions": [
  {
   "t0": 0.0,
   "t1": 0.44,
   "text": "Встал в шесть,"
  },
  {
   "t0": 0.44,
   "t1": 1.719,
   "text": "а ты опоздал?"
  },
  {
   "t0": 1.719,
   "t1": 2.999,
   "text": "Носок, ключи,"
  },
  {
   "t0": 2.999,
   "t1": 3.799,
   "text": "ещё минутка,"
  },
  {
   "t0": 3.799,
   "t1": 5.239,
   "text": "и опять бегом."
  },
  {
   "t0": 5.239,
   "t1": 5.679,
   "text": "Но это"
  },
  {
   "t0": 5.679,
   "t1": 6.423,
   "text": "не лень,"
  },
  {
   "t0": 6.423,
   "t1": 7.079,
   "text": "и в конце"
  },
  {
   "t0": 7.079,
   "t1": 7.799,
   "text": "тебе трюк"
  },
  {
   "t0": 7.799,
   "t1": 8.679,
   "text": "на утро."
  },
  {
   "t0": 8.679,
   "t1": 9.279,
   "text": "Я засёк"
  },
  {
   "t0": 9.279,
   "t1": 10.119,
   "text": "свои сборы:"
  },
  {
   "t0": 10.119,
   "t1": 11.319,
   "text": "думал, десять минут,"
  },
  {
   "t0": 11.319,
   "t1": 12.519,
   "text": "а вышло сорок."
  },
  {
   "t0": 12.519,
   "t1": 13.199,
   "text": "Напиши кот"
  },
  {
   "t0": 13.199,
   "t1": 13.879,
   "text": "в комментах,"
  },
  {
   "t0": 13.879,
   "t1": 14.359,
   "text": "и котик"
  },
  {
   "t0": 14.359,
   "t1": 15.452,
   "text": "Напарник засечёт"
  },
  {
   "t0": 15.452,
   "t1": 15.986,
   "text": "твоё утро"
  },
  {
   "t0": 15.986,
   "t1": 16.919,
   "text": "с тобой."
  },
  {
   "t0": 16.919,
   "t1": 17.719,
   "text": "Голова считает"
  },
  {
   "t0": 17.719,
   "t1": 18.626,
   "text": "сборы короче,"
  },
  {
   "t0": 18.626,
   "t1": 19.666,
   "text": "чем они идут."
  },
  {
   "t0": 19.666,
   "t1": 20.439,
   "text": "Поэтому заведи"
  },
  {
   "t0": 20.439,
   "t1": 21.779,
   "text": "второй будильник,"
  },
  {
   "t0": 21.779,
   "t1": 22.579,
   "text": "который звенит,"
  },
  {
   "t0": 22.579,
   "t1": 24.019,
   "text": "когда пора выходить."
  },
  {
   "t0": 24.019,
   "t1": 24.899,
   "text": "Он звякнул,"
  },
  {
   "t0": 24.899,
   "t1": 25.659,
   "text": "и я вышел"
  },
  {
   "t0": 25.659,
   "t1": 26.606,
   "text": "первым."
  }
 ]
