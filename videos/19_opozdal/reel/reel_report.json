 "captions": [
  {
   "t0": 0.0,
   "t1": 0.44,
   "text": "Встал рано,"
  },
  {
   "t0": 0.44,
   "t1": 1.719,
   "text": "а ты опоздал?"
  },
  {
   "t0": 1.719,
   "t1": 2.359,
   "text": "Два часа"
  },
  {
   "t0": 2.359,
   "t1": 2.959,
   "text": "на сборы,"
  },
  {
   "t0": 2.959,
   "t1": 4.439,
   "text": "а выходишь бегом."
  },
  {
   "t0": 4.439,
   "t1": 4.839,
   "text": "Но дело"
  },
  {
   "t0": 4.839,
   "t1": 5.943,
   "text": "не в будильнике."
  },
  {
   "t0": 5.943,
   "t1": 6.639,
   "text": "Покажу,"
  },
  {
   "t0": 6.639,
   "t1": 7.159,
   "text": "как тебе"
  },
  {
   "t0": 7.159,
   "t1": 8.359,
   "text": "выйти вовремя."
  },
  {
   "t0": 8.359,
   "t1": 8.879,
   "text": "Я вставал"
  },
  {
   "t0": 8.879,
   "t1": 9.439,
   "text": "в шесть,"
  },
  {
   "t0": 9.439,
