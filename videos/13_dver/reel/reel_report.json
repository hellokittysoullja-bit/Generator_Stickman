 "captions": [
  {
   "t0": 0.0,
   "t1": 1.44,
   "text": "Ты шёл и всё забыл?"
  },
  {
   "t0": 1.44,
   "t1": 2.88,
   "text": "Доходишь до кухни,"
  },
  {
   "t0": 2.88,
   "t1": 3.12,
   "text": "а в"
  },
  {
   "t0": 3.12,
   "t1": 4.48,
   "text": "голове пусто."
  },
  {
   "t0": 4.48,
   "t1": 4.88,
   "text": "Но дело"
  },
  {
   "t0": 4.88,
   "t1": 5.72,
   "text": "не в памяти,"
  },
  {
   "t0": 5.72,
   "t1": 5.92,
   "text": "и в"
  },
  {
   "t0": 5.92,
   "t1": 6.72,
   "text": "конце покажу,"
  },
  {
   "t0": 6.72,
   "t1": 7.36,
   "text": "как донести"
  },
  {
   "t0": 7.36,
   "t1": 8.96,
   "text": "мысль до места."
  },
  {
   "t0": 8.96,
   "t1": 9.36,
   "text": "Я так"
  },
  {
   "t0": 9.36,
   "t1": 10.4,
   "text": "хожу за карандашом"
  },
  {
   "t0": 10.4,
   "t1": 11.16,
   "text": "и возвращаюсь"
  },
  {
   "t0": 11.16,
   "t1": 12.24,
   "text": "с бутербродом."
  },
  {
   "t0": 12.24,
   "t1": 12.8,
   "text": "Психолог"
  },
  {
   "t0": 12.8,
   "t1": 13.8,
   "text": "Гэбриел Радванский"
  },
  {
   "t0": 13.8,
   "t1": 14.533,
   "text": "проверил:"
  },
  {
   "t0": 14.533,
   "t1": 15.28,
   "text": "после двери"
  },
  {
   "t0": 15.28,
   "t1": 16.427,
   "text": "люди хуже помнят,"
  },
  {
   "t0": 16.427,
   "t1": 17.32,
   "text": "что несли."
  },
  {
   "t0": 17.32,
   "t1": 18.2,
   "text": "Для мозга дверь"
  },
  {
   "t0": 18.2,
   "t1": 19.44,
   "text": "как конец сцены,"
  },
  {
   "t0": 19.44,
   "t1": 19.96,
   "text": "и мысль"
  },
  {
   "t0": 19.96,
   "t1": 21.12,
   "text": "уходит в архив,"
  },
  {
   "t0": 21.12,
   "t1": 21.84,
   "text": "особенно если"
  },
  {
   "t0": 21.84,
   "t1": 22.92,
   "text": "голова занята."
  },
  {
   "t0": 22.92,
   "t1": 24.2,
   "text": "Теперь я беру"
  },
  {
   "t0": 24.2,
   "t1": 25.48,
   "text": "подсказку в лапу:"
  },
  {
   "t0": 25.48,
   "t1": 26.44,
   "text": "иду за карандашом"
  },
  {
   "t0": 26.44,
   "t1": 27.32,
   "text": "и несу записку"
  },
  {
   "t0": 27.32,
   "t1": 28.4,
   "text": "в одно слово."
  },
  {
   "t0": 28.4,
   "t1": 29.0,
   "text": "Если шаги"
  },
  {
   "t0": 29.0,
   "t1": 30.08,
   "text": "теряются по дороге,"
  },
  {
   "t0": 30.08,
   "t1": 31.0,
   "text": "в шапке профиля"
  },
  {
   "t0": 31.0,
   "t1": 32.24,
   "text": "есть «Напарник»:"
  },
  {
   "t0": 32.24,
   "t1": 32.96,
   "text": "там следующий"
  },
  {
   "t0": 32.96,
   "t1": 34.28,
   "text": "шаг перед глазами."
  },
  {
   "t0": 34.28,
   "t1": 35.57,
   "text": "Бесплатно."
  },
  {
   "t0": 35.57,
   "t1": 36.09,
   "text": "А дальше"
  },
  {
   "t0": 36.09,
   "t1": 37.17,
   "text": "было вот что."
  },
  {
   "t0": 37.17,
   "t1": 37.89,
   "text": "Дошёл до стола"
  },
  {
   "t0": 37.89,
   "t1": 38.93,
   "text": "с карандашом."
  },
  {
   "t0": 38.93,
   "t1": 39.77,
   "text": "И с бутербродом,"
  },
  {
   "t0": 39.77,
   "t1": 40.837,
   "text": "конечно."
  }
 ]
}