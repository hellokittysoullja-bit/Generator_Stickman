 "captions": [
  {
   "t0": 0.0,
   "t1": 0.344,
   "text": "Тянешь, чтобы"
  },
  {
   "t0": 0.344,
   "t1": 1.722,
   "text": "было идеально?"
  },
  {
   "t0": 1.722,
   "t1": 1.949,
   "text": "Ты"
  },
  {
   "t0": 1.949,
   "t1": 2.909,
   "text": "ждёшь правильного"
  },
  {
   "t0": 2.909,
   "t1": 3.696,
   "text": "момента,"
  },
  {
   "t0": 3.696,
   "t1": 4.189,
   "text": "но он так"
  },
  {
   "t0": 4.189,
   "t1": 5.429,
   "text": "и не приходит."
  },
  {
   "t0": 5.429,
   "t1": 6.109,
   "text": "Я три недели"
  },
  {
   "t0": 6.109,
   "t1": 7.149,
   "text": "ждал настроения"
  },
  {
   "t0": 7.149,
   "t1": 8.309,
   "text": "помыть свою миску."
  },
  {
   "t0": 8.309,
   "t1": 9.136,
   "text": "Настроение"
  },
  {
   "t0": 9.136,
   "t1": 10.029,
   "text": "не пришло,"
  },
  {
   "t0": 10.029,
   "t1": 10.858,
