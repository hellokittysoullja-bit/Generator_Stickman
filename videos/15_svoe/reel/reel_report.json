 "captions": [
  {
   "t0": 0.0,
   "t1": 1.719,
   "text": "Чужое сдашь, а своё?"
  },
  {
   "t0": 1.719,
   "t1": 2.519,
   "text": "Другу поможешь"
  },
  {
   "t0": 2.519,
   "t1": 3.119,
   "text": "за вечер,"
  },
  {
   "t0": 3.119,
   "t1": 3.639,
   "text": "а своё"
  },
  {
   "t0": 3.639,
   "t1": 4.919,
   "text": "лежит месяцами,"
  },
  {
   "t0": 4.919,
   "t1": 5.559,
   "text": "и это даже"
  },
  {
   "t0": 5.559,
   "t1": 6.386,
   "text": "не лень."
  },
  {
   "t0": 6.386,
   "t1": 6.599,
   "text": "Но в"
  },
  {
   "t0": 6.599,
   "t1": 7.599,
   "text": "конце покажу,"
  },
  {
   "t0": 7.599,
   "t1": 9.079,
   "text": "как начать своё."
  },
  {
   "t0": 9.079,
   "t1": 9.639,
   "text": "Я другу"
  },
  {
   "t0": 9.639,
   "t1": 10.959,
   "text": "весь переезд таскал,"
  },
  {
   "t0": 10.959,
   "t1": 11.799,
   "text": "а моя гитара"
  },
  {
   "t0": 11.799,
   "t1": 12.919,
   "text": "год в пыли."
  },
  {
   "t0": 12.919,
   "t1": 14.306,
   "text": "Учёный Дэн Ариели"
  },
  {
   "t0": 14.306,
   "t1": 15.519,
   "text": "проверил студентов:"
  },
  {
   "t0": 15.519,
   "t1": 16.879,
   "text": "свои сроки срывали,"
  },
  {
   "t0": 16.879,
   "t1": 18.599,
   "text": "а чужие выполняли."
  },
  {
   "t0": 18.599,
   "t1": 19.919,
   "text": "Чужое кто-то ждёт,"
  },
  {
   "t0": 19.919,
   "t1": 21.399,
   "text": "а своё никто."
  },
  {
   "t0": 21.399,
   "t1": 22.239,
   "text": "Своему делу"
  },
  {
   "t0": 22.239,
   "t1": 23.739,
   "text": "нужен свидетель:"
  },
  {
   "t0": 23.739,
   "t1": 24.659,
   "text": "скажи кому-то"
  },
  {
   "t0": 24.659,
   "t1": 25.859,
   "text": "«в восемь сажусь»."
  },
  {
   "t0": 25.859,
   "t1": 26.819,
   "text": "Скажи хоть мне,"
  },
  {
   "t0": 26.819,
   "t1": 27.339,
   "text": "«Напарник» в"
  },
  {
   "t0": 27.339,
   "t1": 28.259,
   "text": "шапке профиля,"
  },
  {
   "t0": 28.259,
   "t1": 28.859,
   "text": "я подожду"
  },
  {
   "t0": 28.859,
   "t1": 29.699,
   "text": "пару минут."
  },
  {
   "t0": 29.699,
   "t1": 30.826,
   "text": "Бесплатно."
  },
  {
   "t0": 30.826,
   "t1": 31.279,
   "text": "И смотри,"
  },
  {
   "t0": 31.279,
   "t1": 32.279,
   "text": "что с гитарой."
  },
  {
   "t0": 32.279,
   "t1": 33.332,
   "text": "Сказал соседу:"
  },
  {
   "t0": 33.332,
   "t1": 34.452,
   "text": "«в восемь играю»,"
  },
  {
   "t0": 34.452,
   "t1": 35.039,
   "text": "и в восемь"
  },
  {
   "t0": 35.039,
   "t1": 35.519,
   "text": "ноль пять"
  },
  {
   "t0": 35.519,
   "t1": 36.039,
   "text": "он стучал"
  },
  {
   "t0": 36.039,
   "t1": 37.306,
   "text": "в стенку."
  }
 ]
}