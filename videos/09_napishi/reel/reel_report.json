 ],
 "captions": [
  {
   "t0": 0.0,
   "t1": 1.4,
   "text": "Ждёшь, кто напишет?"
  },
  {
   "t0": 1.4,
   "t1": 2.84,
   "text": "Никто не напишет,"
  },
  {
   "t0": 2.84,
   "t1": 3.4,
   "text": "и вовсе"
  },
  {
   "t0": 3.4,
   "t1": 3.96,
   "text": "не потому,"
  },
  {
   "t0": 3.96,
   "t1": 4.28,
   "text": "что ты"
  },
  {
   "t0": 4.28,
   "t1": 5.16,
   "text": "им не нужен."
  },
  {
   "t0": 5.16,
   "t1": 6.04,
   "text": "Но в конце"
  },
  {
   "t0": 6.04,
   "t1": 6.52,
   "text": "я всё-таки"
  },
  {
   "t0": 6.52,
   "t1": 8.2,
   "text": "напишу первым."
  },
  {
   "t0": 8.2,
   "t1": 9.16,
   "text": "Психологи Лю"
  },
  {
   "t0": 9.16,
   "t1": 9.64,
   "text": "и Рим"
  },
  {
   "t0": 9.64,
   "t1": 10.44,
   "text": "просили написать"
  },
  {
   "t0": 10.44,
   "t1": 11.68,
   "text": "знакомым без повода"
  },
  {
   "t0": 11.68,
   "t1": 12.4,
   "text": "и угадать,"
  },
  {
   "t0": 12.4,
   "t1": 13.84,
   "text": "как те обрадуются."
  },
  {
   "t0": 13.84,
   "t1": 14.64,
   "text": "Им радовались"
  },
  {
   "t0": 14.64,
   "t1": 15.24,
   "text": "сильнее, чем"
  },
  {
   "t0": 15.24,
   "t1": 16.12,
   "text": "они думали,"
  },
  {
   "t0": 16.12,
   "t1": 17.08,
   "text": "и тем сильнее,"
  },
  {
   "t0": 17.08,
   "t1": 18.36,
   "text": "чем неожиданнее."
  },
  {
   "t0": 18.36,
   "t1": 19.507,
   "text": "Поэтому все ждут,"
  },
  {
   "t0": 19.507,
   "t1": 20.72,
   "text": "что напишет другой,"
  },
  {
   "t0": 20.72,
   "t1": 22.2,
   "text": "и молчат оба."
  },
  {
   "t0": 22.2,
   "t1": 22.6,
   "text": "Я так"
  },
  {
   "t0": 22.6,
   "t1": 24.04,
   "text": "ждал полгода."
  },
  {
   "t0": 24.04,
   "t1": 25.37,
   "text": "Просто черкни"
  },
  {
   "t0": 25.37,
   "t1": 26.05,
   "text": "одну строчку"
  },
  {
   "t0": 26.05,
   "t1": 27.09,
   "text": "без повода:"
  },
  {
   "t0": 27.09,
   "t1": 27.93,
   "text": "как ты."
  },
  {
   "t0": 27.93,
   "t1": 28.89,
   "text": "В шапке профиля"
  },
  {
   "t0": 28.89,
   "t1": 29.61,
   "text": "я помогу тебе"
  },
  {
   "t0": 29.61,
   "t1": 30.77,
   "text": "начать твоё дело,"
  },
  {
   "t0": 30.77,
   "t1": 31.21,
   "text": "а также"
  },
  {
   "t0": 31.21,
   "t1": 31.93,
   "text": "посижу с тобой"
  },
  {
   "t0": 31.93,
   "t1": 32.543,
   "text": "пару минут,"
  },
  {
   "t0": 32.543,
   "t1": 33.77,
   "text": "пока ты начинаешь."
  },
  {
   "t0": 33.77,
   "t1": 34.81,
   "text": "Бесплатно."
  },
  {
   "t0": 34.81,
   "t1": 35.37,
   "text": "Смотри, что"
  },
  {
   "t0": 35.37,
   "t1": 36.41,
   "text": "мне ответили."
  },
  {
   "t0": 36.41,
   "t1": 37.17,
   "text": "Я написал"
  },
  {
   "t0": 37.17,
   "t1": 37.89,
   "text": "«как ты?»,"
  },
  {
   "t0": 37.89,
   "t1": 38.21,
   "text": "и мне"
  },
  {
   "t0": 38.21,
   "t1": 39.21,
   "text": "сразу пришло"
  },
  {
   "t0": 39.21,
   "t1": 39.81,
   "text": "«я как раз"
  },
  {
   "t0": 39.81,
   "t1": 41.157,
   "text": "о тебе думал»."
  }
 ]
