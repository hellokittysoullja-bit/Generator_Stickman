 ],
 "captions": [
  {
   "t0": 0.0,
   "t1": 1.4,
   "text": "Веришь в «потом»?"
  },
  {
   "t0": 1.4,
   "t1": 2.067,
   "text": "Закладки,"
  },
  {
   "t0": 2.067,
   "t1": 3.4,
   "text": "«с понедельника»?"
  },
  {
   "t0": 3.4,
   "t1": 3.92,
   "text": "Но дело не"
  },
  {
   "t0": 3.92,
   "t1": 4.96,
   "text": "в силе воли,"
  },
  {
   "t0": 4.96,
   "t1": 5.4,
   "text": "и одно"
  },
  {
   "t0": 5.4,
   "t1": 5.92,
   "text": "видео я"
  },
  {
   "t0": 5.92,
   "t1": 7.2,
   "text": "в итоге открыл."
  },
  {
   "t0": 7.2,
   "t1": 7.88,
   "text": "«Потом» ведь"
  },
  {
   "t0": 7.88,
   "t1": 9.48,
   "text": "делает не ты."
  },
  {
   "t0": 9.48,
   "t1": 10.28,
   "text": "Психолог Хэл"
  },
  {
   "t0": 10.28,
   "t1": 11.24,
   "text": "Хершфилд смотрел"
  },
  {
   "t0": 11.24,
   "t1": 12.32,
   "text": "на томографе:"
  },
  {
   "t0": 12.32,
   "t1": 12.76,
   "text": "о себе"
  },
  {
   "t0": 12.76,
   "t1": 13.8,
   "text": "через десять лет"
  },
  {
   "t0": 13.8,
   "t1": 14.84,
   "text": "мозг думает почти"
  },
  {
   "t0": 14.84,
   "t1": 15.92,
   "text": "как о чужом."
  },
  {
   "t0": 15.92,
   "t1": 17.08,
   "text": "«Потом» легко:"
  },
  {
   "t0": 17.08,
   "t1": 18.08,
   "text": "возьмёт другой,"
  },
  {
   "t0": 18.08,
   "t1": 18.76,
   "text": "а приходит"
  },
  {
   "t0": 18.76,
   "t1": 19.72,
   "text": "снова ты."
  },
  {
   "t0": 19.72,
   "t1": 20.333,
   "text": "И я,"
  },
  {
   "t0": 20.333,
   "t1": 21.0,
   "text": "как и ты,"
  },
  {
   "t0": 21.0,
   "t1": 22.28,
   "text": "копил закладки."
  },
  {
   "t0": 22.28,
   "t1": 22.92,
   "text": "Не отдавай"
  },
  {
   "t0": 22.92,
   "t1": 24.25,
   "text": "ему всё."
  },
  {
   "t0": 24.25,
   "t1": 24.65,
   "text": "Минуту"
  },
  {
   "t0": 24.65,
   "t1": 25.81,
   "text": "сделай сейчас,"
  },
  {
   "t0": 25.81,
   "t1": 26.73,
   "text": "остальное пусть"
  },
  {
   "t0": 26.73,
   "t1": 27.77,
   "text": "берёт он."
  },
  {
   "t0": 27.77,
   "t1": 28.65,
   "text": "В шапке профиля"
  },
  {
   "t0": 28.65,
   "t1": 29.49,
   "text": "я помогу тебе"
  },
  {
   "t0": 29.49,
   "t1": 30.61,
   "text": "начать твоё дело,"
  },
  {
   "t0": 30.61,
   "t1": 31.05,
   "text": "а также"
  },
  {
   "t0": 31.05,
   "t1": 31.77,
   "text": "посижу с тобой"
  },
  {
   "t0": 31.77,
   "t1": 32.37,
   "text": "пару минут,"
  },
  {
   "t0": 32.37,
   "t1": 33.61,
   "text": "пока ты начинаешь."
  },
  {
   "t0": 33.61,
   "t1": 34.57,
   "text": "Бесплатно."
  },
  {
   "t0": 34.57,
   "t1": 35.65,
   "text": "Смотри, что стало"
  },
  {
   "t0": 35.65,
   "t1": 36.73,
   "text": "с закладками."
  },
  {
   "t0": 36.73,
   "t1": 37.61,
   "text": "Я открыл одно"
  },
  {
   "t0": 37.61,
   "t1": 38.57,
   "text": "видео на минуту"
  },
  {
   "t0": 38.57,
   "t1": 39.21,
   "text": "и досмотрел"
  },
  {
   "t0": 39.21,
   "t1": 40.01,
   "text": "до конца."
  },
  {
   "t0": 40.01,
   "t1": 41.09,
   "text": "Остальные висят"
  },
  {
   "t0": 41.09,
   "t1": 42.357,
   "text": "до сих пор."
  }
 ]
