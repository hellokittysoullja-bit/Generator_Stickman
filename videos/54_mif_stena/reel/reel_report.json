   "t0": 14.69,
   "t1": 15.21,
   "text": "что ты"
  },
  {
   "t0": 15.21,
   "t1": 16.583,
   "text": "ничего не построил."
  },
  {
   "t0": 16.583,
   "t1": 18.13,
   "text": "А вблизи видно"
  },
  {
