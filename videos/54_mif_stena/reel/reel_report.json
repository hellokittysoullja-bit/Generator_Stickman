  },
  {
   "t0": 24.29,
   "t1": 25.703,
   "text": "Напарник ответит."
  },
  {
   "t0": 25.703,
   "t1": 26.77,
   "text": "А теперь смотри,"
  },
  {
   "t0": 26.77,
   "t1": 27.09,
