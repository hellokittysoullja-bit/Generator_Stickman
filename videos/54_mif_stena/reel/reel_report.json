   "text": "положил сегодня."
  },
  {
   "t0": 21.01,
   "t1": 21.943,
   "text": "Напиши в комментах,"
  },
  {
   "t0": 21.943,
   "t1": 22.69,
   "text": "какой кирпич"
  },
  {
   "t0": 22.69,
   "t1": 23.81,
   "text": "ты положил сегодня,"
  },
  {
   "t0": 23.81,
   "t1": 24.29,
