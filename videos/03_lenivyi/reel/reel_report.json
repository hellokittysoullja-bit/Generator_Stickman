 "captions": [
  {
   "t0": 0.0,
   "t1": 1.65,
   "text": "Тебя звали ленивым."
  },
  {
   "t0": 1.65,
   "t1": 1.97,
   "text": "И ты"
  },
  {
   "t0": 1.97,
   "t1": 2.73,
   "text": "за годы сам"
  },
  {
   "t0": 2.73,
   "t1": 3.97,
   "text": "в это поверил."
  },
  {
   "t0": 3.97,
   "t1": 5.29,
   "text": "Дело висит, ты"
  },
  {
   "t0": 5.29,
   "t1": 6.13,
   "text": "лежишь и всё"
  },
  {
   "t0": 6.13,
   "t1": 7.33,
   "text": "равно устаёшь,"
  },
  {
   "t0": 7.33,
   "t1": 8.21,
   "text": "потому что весь"
  },
  {
   "t0": 8.21,
   "t1": 8.903,
   "text": "день грызёшь"
  },
  {
   "t0": 8.903,
   "t1": 9.89,
   "text": "себя за него."
  },
  {
   "t0": 9.89,
   "t1": 10.29,
   "text": "У меня"
  },
  {
   "t0": 10.29,
   "t1": 11.13,
   "text": "тоже так,"
  },
  {
   "t0": 11.13,
   "t1": 11.89,
   "text": "и я годами"
  },
  {
   "t0": 11.89,
   "t1": 12.57,
   "text": "думал, что мне"
  },
  {
   "t0": 12.57,
   "t1": 13.13,
   "text": "не хватает"
  },
  {
   "t0": 13.13,
   "t1": 14.13,
   "text": "силы воли."
  },
  {
   "t0": 14.13,
   "t1": 14.61,
   "text": "Но дело"
  },
  {
   "t0": 14.61,
   "t1": 14.97,
   "text": "было не"
  },
  {
   "t0": 14.97,
   "t1": 15.81,
   "text": "в силе воли"
  },
  {
   "t0": 15.81,
   "t1": 16.05,
   "text": "и не"
  },
  {
   "t0": 16.05,
   "t1": 16.85,
   "text": "в лени."
  },
  {
   "t0": 16.85,
   "t1": 17.93,
   "text": "Мне было страшно"
  },
  {
   "t0": 17.93,
   "t1": 18.89,
   "text": "начать и опять"
  },
  {
   "t0": 18.89,
   "t1": 20.05,
   "text": "не справиться."
  },
  {
   "t0": 20.05,
   "t1": 21.69,
   "text": "Лень не болит."
  },
  {
   "t0": 21.69,
