 "captions": [
  {
   "t0": 0.0,
   "t1": 1.65,
   "text": "Тебя звали ленивым."
  },
  {
   "t0": 1.65,
   "t1": 1.97,
   "text": "И ты"
  },
  {
   "t0": 1.97,
   "t1": 2.73,
   "text": "за годы сам"
  },
  {
   "t0": 2.73,
   "t1": 3.89,
   "text": "в это поверил."
  },
  {
   "t0": 3.89,
   "t1": 4.81,
   "text": "Но если просто"
  },
  {
   "t0": 4.81,
   "t1": 5.89,
   "text": "заставлять себя,"
  },
  {
   "t0": 5.89,
   "t1": 7.49,
   "text": "станет только хуже."
  },
  {
   "t0": 7.49,
   "t1": 8.81,
   "text": "Дело висит, ты"
  },
  {
   "t0": 8.81,
   "t1": 9.73,
   "text": "лежишь и всё"
  },
  {
   "t0": 9.73,
   "t1": 10.93,
   "text": "равно устаёшь,"
  },
  {
   "t0": 10.93,
   "t1": 11.863,
   "text": "потому что грызёшь"
  },
  {
   "t0": 11.863,
   "t1": 12.85,
   "text": "себя за него."
  },
  {
   "t0": 12.85,
   "t1": 13.17,
   "text": "У меня"
  },
  {
   "t0": 13.17,
   "t1": 13.97,
   "text": "тоже так,"
  },
  {
   "t0": 13.97,
   "t1": 14.77,
   "text": "и я годами"
  },
  {
   "t0": 14.77,
   "t1": 15.49,
   "text": "думал, что мне"
  },
  {
   "t0": 15.49,
   "t1": 16.05,
   "text": "не хватает"
  },
  {
   "t0": 16.05,
   "t1": 17.01,
   "text": "силы воли."
  },
  {
   "t0": 17.01,
   "t1": 17.49,
   "text": "Но дело"
  },
  {
   "t0": 17.49,
   "t1": 17.85,
   "text": "было не"
  },
  {
   "t0": 17.85,
   "t1": 18.69,
   "text": "в силе воли"
  },
  {
   "t0": 18.69,
   "t1": 18.93,
   "text": "и не"
  },
  {
   "t0": 18.93,
   "t1": 19.73,
   "text": "в лени."
  },
  {
   "t0": 19.73,
   "t1": 20.61,
   "text": "Мне было страшно"
  },
  {
   "t0": 20.61,
   "t1": 21.77,
   "text": "начать и опять"
  },
  {
   "t0": 21.77,
   "t1": 23.01,
   "text": "не справиться."
  },
  {
   "t0": 23.01,
   "t1": 24.57,
   "text": "Лень не болит."
  },
  {
   "t0": 24.57,
   "t1": 24.73,
   "text": "А у"
  },
  {
   "t0": 24.73,
   "t1": 26.09,
   "text": "тебя болит."
  },
  {
   "t0": 26.09,
   "t1": 26.81,
   "text": "Я перестал"
  },
  {
   "t0": 26.81,
   "t1": 27.53,
   "text": "ждать сил"
  },
  {
   "t0": 27.53,
   "t1": 28.143,
   "text": "и начинал,"
  },
  {
   "t0": 28.143,
   "t1": 29.21,
   "text": "когда рядом кто-то"
  },
  {
   "t0": 29.21,
   "t1": 30.81,
   "text": "молча делал своё."
  },
  {
   "t0": 30.81,
   "t1": 31.93,
   "text": "Напиши в комментах,"
  },
  {
   "t0": 31.93,
   "t1": 32.45,
   "text": "кто тебе"
  },
  {
   "t0": 32.45,
   "t1": 33.37,
   "text": "это говорил."
  },
  {
   "t0": 33.37,
   "t1": 34.25,
   "text": "И отправь тому,"
  },
  {
   "t0": 34.25,
   "t1": 34.65,
   "text": "кто до"
  },
  {
   "t0": 34.65,
   "t1": 35.13,
   "text": "сих пор"
  },
  {
   "t0": 35.13,
   "t1": 36.917,
   "text": "зовёт тебя ленивым."
  }
 ]
