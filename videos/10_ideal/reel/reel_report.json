 "captions": [
  {
   "t0": 0.0,
   "t1": 1.4,
   "text": "Ждёшь идеала?"
  },
  {
   "t0": 1.4,
   "t1": 2.52,
   "text": "Он не придёт,"
  },
  {
   "t0": 2.52,
   "t1": 3.2,
   "text": "и вовсе не"
  },
  {
   "t0": 3.2,
   "t1": 3.96,
   "text": "по той причине,"
  },
  {
   "t0": 3.96,
   "t1": 4.52,
   "text": "о которой"
  },
  {
   "t0": 4.52,
   "t1": 5.88,
   "text": "ты думаешь."
  },
  {
   "t0": 5.88,
   "t1": 6.44,
   "text": "Но это"
  },
  {
   "t0": 6.44,
   "t1": 7.24,
   "text": "не лень,"
  },
  {
   "t0": 7.24,
   "t1": 7.96,
   "text": "а одна"
  },
  {
   "t0": 7.96,
   "t1": 9.213,
   "text": "хорошая вещь,"
  },
  {
   "t0": 9.213,
   "t1": 9.72,
   "text": "и в конце"
  },
  {
   "t0": 9.72,
   "t1": 10.28,
   "text": "покажу, что"
  },
  {
   "t0": 10.28,
   "t1": 11.16,
   "text": "с ней делать."
  },
  {
   "t0": 11.16,
   "t1": 11.92,
   "text": "Айра Гласс"
  },
  {
   "t0": 11.92,
   "t1": 13.213,
   "text": "зовёт это разрывом:"
  },
  {
   "t0": 13.213,
   "t1": 14.04,
   "text": "вкус хороший,"
  },
  {
   "t0": 14.04,
   "t1": 14.52,
   "text": "а руки"
  },
  {
   "t0": 14.52,
   "t1": 15.16,
   "text": "ещё нет,"
  },
  {
   "t0": 15.16,
   "t1": 15.8,
   "text": "и первое"
  },
  {
   "t0": 15.8,
   "t1": 17.533,
   "text": "выходит ужасным."
  },
  {
   "t0": 17.533,
   "t1": 18.44,
   "text": "Психологи свели"
  },
  {
   "t0": 18.44,
   "t1": 19.88,
   "text": "больше сорока работ:"
  },
  {
   "t0": 19.88,
   "t1": 20.52,
   "text": "чем сильнее"
  },
  {
   "t0": 20.52,
   "t1": 21.4,
   "text": "страх ошибки,"
  },
  {
   "t0": 21.4,
   "t1": 22.04,
   "text": "тем дольше"
  },
  {
   "t0": 22.04,
   "t1": 22.947,
   "text": "откладываешь."
  },
  {
   "t0": 22.947,
   "t1": 23.85,
   "text": "Поэтому"
  },
  {
   "t0": 23.85,
   "t1": 24.81,
   "text": "первые пять минут"
  },
  {
   "t0": 24.81,
   "t1": 26.463,
   "text": "делай нарочно плохо."
  },
  {
   "t0": 26.463,
   "t1": 27.37,
   "text": "В шапке профиля"
  },
  {
   "t0": 27.37,
   "t1": 28.13,
   "text": "я помогу тебе"
  },
  {
   "t0": 28.13,
   "t1": 29.21,
   "text": "начать твоё дело,"
  },
  {
   "t0": 29.21,
   "t1": 29.65,
   "text": "а также"
  },
  {
   "t0": 29.65,
   "t1": 30.33,
   "text": "посижу с тобой"
  },
  {
   "t0": 30.33,
   "t1": 30.863,
   "text": "пару минут,"
  },
  {
   "t0": 30.863,
   "t1": 32.01,
   "text": "пока ты начинаешь."
  },
  {
   "t0": 32.01,
   "t1": 32.89,
   "text": "Бесплатно."
  },
  {
   "t0": 32.89,
   "t1": 33.49,
   "text": "Смотри, что"
  },
  {
   "t0": 33.49,
   "t1": 34.49,
   "text": "было дальше."
  },
  {
   "t0": 34.49,
   "t1": 35.09,
   "text": "Я нарисовал"
  },
  {
   "t0": 35.09,
   "t1": 35.81,
   "text": "кривой домик"
  },
  {
   "t0": 35.81,
   "t1": 36.73,
   "text": "за пять минут,"
  },
  {
   "t0": 36.73,
   "t1": 36.97,
   "text": "а к"
  },
  {
   "t0": 36.97,
   "t1": 37.81,
   "text": "вечеру стал"
  },
  {
   "t0": 37.81,
   "t1": 38.41,
   "text": "ровным."
  },
  {
   "t0": 38.41,
   "t1": 39.29,
   "text": "Идеала так"
  },
  {
   "t0": 39.29,
   "t1": 40.757,
   "text": "и не дождался."
  }
 ]
}