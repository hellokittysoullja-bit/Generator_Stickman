   "text": "«слепотой"
  },
  {
   "t0": 12.502,
   "t1": 13.863,
   "text": "ко времени»."
  },
  {
   "t0": 13.863,
   "t1": 14.686,
   "text": "Одного таймера"
  },
  {
   "t0": 14.686,
   "t1": 15.481,
   "text": "тут мало."
  },
  {
   "t0": 15.481,
   "t1": 16.305,
   "text": "Что помогает —"
  },
  {
   "t0": 16.305,
   "t1": 16.935,
   "text": "покажу."
  },
  {
   "t0": 16.935,
   "t1": 17.523,
   "text": "Интересное"
  },
  {
   "t0": 17.523,
   "t1": 18.288,
   "text": "съедает вечер"
  },
  {
   "t0": 18.288,
   "t1": 19.149,
   "text": "за минуту."
  },
  {
   "t0": 19.149,
   "t1": 19.74,
   "text": "А скучное"
  },
  {
   "t0": 19.74,
   "t1": 20.681,
   "text": "тянется вечность."
  },
  {
   "t0": 20.681,
   "t1": 21.668,
   "text": "Но вот ловушка:"
  },
  {
   "t0": 21.668,
   "t1": 22.529,
   "text": "ставишь таймер."
  },
  {
   "t0": 22.529,
   "t1": 23.325,
   "text": "Он звенит."
  },
  {
   "t0": 23.325,
   "t1": 24.725,
   "text": "Выключаешь…"
  },
  {
   "t0": 24.725,
   "t1": 25.651,
   "text": "и продолжаешь."
  },
  {
   "t0": 25.651,
   "t1": 26.512,
   "text": "Таймер звенит."
  },
  {
   "t0": 26.512,
   "t1": 27.268,
   "text": "Но не сидит"
  },
  {
   "t0": 27.268,
   "t1": 27.834,
   "text": "рядом."
  },
  {
   "t0": 27.834,
   "t1": 28.54,
   "text": "Многим легче,"
  },
  {
   "t0": 28.54,
   "t1": 29.187,
   "text": "когда рядом"
  },
  {
   "t0": 29.187,
   "t1": 29.983,
   "text": "кто-то есть."
  },
  {
   "t0": 29.983,
   "t1": 30.512,
   "text": "Хоть друг"
  },
  {
   "t0": 30.512,
   "t1": 31.373,
   "text": "по видео."
  },
  {
   "t0": 31.373,
   "t1": 32.095,
   "text": "Это называют"
  },
  {
   "t0": 32.095,
   "t1": 33.291,
   "text": "боди-даблинг."
  },
  {
   "t0": 33.291,
   "t1": 34.178,
   "text": "Даже если этот"
  },
  {
   "t0": 34.178,
   "t1": 34.766,
   "text": "«кто-то» —"
  },
  {
   "t0": 34.766,
   "t1": 35.758,
   "text": "нарисованный"
  },
  {
   "t0": 35.758,
   "t1": 36.258,
   "text": "кот."
  },
  {
   "t0": 36.258,
   "t1": 36.847,
   "text": "«Напарник»"
  },
  {
   "t0": 36.847,
   "t1": 37.643,
   "text": "не лечит."
  },
  {
   "t0": 37.643,
   "t1": 38.231,
   "text": "Просто кот"
  },
  {
   "t0": 38.231,
   "t1": 38.796,
   "text": "рядом."
  },
  {
   "t0": 38.796,
   "t1": 39.502,
   "text": "Отправь тому,"
  },
  {
   "t0": 39.502,
   "t1": 40.189,
   "text": "кто думает,"
  },
  {
   "t0": 40.189,
   "t1": 41.281,
   "text": "что ты ленишься."
  },
  {
   "t0": 41.281,
   "t1": 41.781,
   "text": "Ссылка —"
  },
  {
   "t0": 41.781,
   "t1": 42.577,
   "text": "в шапке."
  },
  {
   "t0": 42.577,
   "t1": 43.207,
   "text": "Бесплатно."
  },
  {
   "t0": 43.207,
   "t1": 44.029,
   "text": "Начни с пяти"
  },
  {
   "t0": 44.029,
   "t1": 44.594,
   "text": "минут."
  },
  {
   "t0": 44.594,
   "t1": 45.66,
   "text": "Настоящих."
  }
 ]
}