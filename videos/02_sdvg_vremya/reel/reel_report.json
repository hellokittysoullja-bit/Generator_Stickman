  {
   "t0": 0.183,
   "t1": 0.713,
   "text": "«Ещё пять"
  },
  {
   "t0": 0.713,
   "t1": 1.383,
   "text": "минут»…"
  },
  {
   "t0": 1.383,
   "t1": 2.206,
   "text": "Поднял глаза —"
  },
  {
   "t0": 2.206,
   "t1": 3.002,
   "text": "уже ночь."
  },
  {
   "t0": 3.002,
   "t1": 3.528,
   "text": "А дело"
  },
  {
   "t0": 3.528,
   "t1": 4.389,
   "text": "не начато."
  },
  {
   "t0": 4.389,
   "t1": 5.145,
   "text": "Ты думаешь:"
  },
  {
   "t0": 5.145,
   "t1": 5.675,
   "text": "«я просто"
  },
  {
   "t0": 5.675,
   "t1": 6.306,
   "text": "ленивый»."
  },
  {
   "t0": 6.306,
   "t1": 8.226,
   "text": "Нет."
  },
  {
   "t0": 8.226,
   "t1": 9.109,
   "text": "Психолог Рассел"
  },
  {
   "t0": 9.109,
   "t1": 9.609,
   "text": "Баркли:"
  },
  {
   "t0": 9.609,
   "t1": 10.315,
   "text": "это «слепота"
  },
  {
   "t0": 10.315,
   "t1": 11.175,
   "text": "ко времени»."
  },
  {
   "t0": 11.175,
   "t1": 12.116,
   "text": "Так часто бывает"
  },
  {
   "t0": 12.116,
   "t1": 12.847,
   "text": "при СДВГ."
  },
  {
   "t0": 12.847,
   "t1": 13.734,
   "text": "И без диагноза"
  },
  {
   "t0": 13.734,
   "t1": 14.299,
   "text": "тоже."
  },
  {
   "t0": 14.299,
   "t1": 14.946,
   "text": "Таймер тебя"
  },
  {
   "t0": 14.946,
   "t1": 15.742,
   "text": "не спасёт."
  },
  {
   "t0": 15.742,
   "t1": 16.242,
   "text": "Почему —"
  },
  {
   "t0": 16.242,
   "t1": 17.177,
   "text": "и что спасает —"
  },
  {
   "t0": 17.177,
   "t1": 17.742,
   "text": "дальше."
  },
  {
   "t0": 17.742,
   "t1": 18.683,
   "text": "Для такого мозга"
  },
  {
   "t0": 18.683,
   "t1": 19.683,
   "text": "часто есть только"
  },
  {
   "t0": 19.683,
   "t1": 20.352,
   "text": "«сейчас»…"
  },
  {
   "t0": 20.352,
   "t1": 21.378,
   "text": "и «не сейчас»."
  },
  {
   "t0": 21.378,
   "t1": 22.304,
   "text": "Середины нет."
  },
  {
   "t0": 22.304,
   "t1": 22.892,
   "text": "Интересное"
  },
  {
   "t0": 22.892,
   "t1": 23.657,
   "text": "съедает вечер"
  },
  {
   "t0": 23.657,
   "t1": 24.518,
   "text": "за минуту."
  },
  {
   "t0": 24.518,
   "t1": 25.109,
   "text": "А скучное"
  },
  {
   "t0": 25.109,
   "t1": 26.05,
   "text": "тянется вечность."
  },
  {
   "t0": 26.05,
   "t1": 26.742,
   "text": "Но вот где"
  },
  {
   "t0": 26.742,
   "t1": 27.268,
   "text": "ловушка:"
  },
  {
   "t0": 27.268,
   "t1": 28.129,
   "text": "ставишь таймер."
  },
  {
   "t0": 28.129,
   "t1": 28.924,
   "text": "Он звенит."
  },
  {
   "t0": 28.924,
   "t1": 30.555,
   "text": "Ты выключаешь…"
  },
  {
   "t0": 30.555,
   "t1": 31.481,
   "text": "и продолжаешь."
  },
  {
   "t0": 31.481,
   "t1": 32.246,
   "text": "Таймер только"
  },
  {
   "t0": 32.246,
   "t1": 32.811,
   "text": "звенит."
  },
  {
   "t0": 32.811,
   "t1": 33.568,
   "text": "Он не сидит"
  },
  {
   "t0": 33.568,
   "t1": 34.133,
   "text": "рядом."
  },
  {
   "t0": 34.133,
   "t1": 34.633,
   "text": "Работает"
  },
  {
   "t0": 34.633,
   "t1": 35.133,
   "text": "другое —"
  },
  {
   "t0": 35.133,
   "t1": 35.839,
   "text": "боди-даблинг:"
  },
  {
   "t0": 35.839,
   "t1": 36.545,
   "text": "многим легче,"
  },
  {
   "t0": 36.545,
   "t1": 37.192,
   "text": "когда рядом"
  },
  {
   "t0": 37.192,
   "t1": 37.987,
   "text": "кто-то есть."
  },
  {
   "t0": 37.987,
   "t1": 39.183,
   "text": "А этот «кто-то»…"
  },
  {
   "t0": 39.183,
   "t1": 39.771,
   "text": "может быть"
  },
  {
   "t0": 39.771,
   "t1": 40.477,
   "text": "нарисованным"
  },
  {
   "t0": 40.477,
   "t1": 41.043,
   "text": "котом."
  },
  {
   "t0": 41.043,
   "t1": 41.749,
   "text": "«Напарник» —"
  },
  {
   "t0": 41.749,
   "t1": 42.371,
   "text": "кот рядом,"
  },
  {
   "t0": 42.371,
   "t1": 43.258,
   "text": "пока ты делаешь"
  },
