 "captions": [
  {
   "t0": 0.183,
   "t1": 0.713,
   "text": "«Ещё пять"
  },
  {
   "t0": 0.713,
   "t1": 1.383,
   "text": "минут»…"
  },
  {
   "t0": 1.383,
   "t1": 1.971,
   "text": "Поднимаешь"
  },
  {
   "t0": 1.971,
   "t1": 2.471,
   "text": "глаза —"
  },
  {
   "t0": 2.471,
   "t1": 3.267,
   "text": "уже ночь."
  },
  {
   "t0": 3.267,
   "t1": 3.793,
   "text": "А дело"
  },
  {
   "t0": 3.793,
   "t1": 4.654,
   "text": "не начато."
  },
  {
   "t0": 4.654,
   "t1": 5.183,
   "text": "«Я просто"
  },
  {
   "t0": 5.183,
   "t1": 5.801,
   "text": "ленюсь»?"
  },
  {
   "t0": 5.801,
   "t1": 7.722,
   "text": "Нет."
  },
  {
   "t0": 7.722,
   "t1": 8.604,
   "text": "Психолог Рассел"
  },
  {
   "t0": 8.604,
   "t1": 9.104,
   "text": "Баркли:"
  },
  {
   "t0": 9.104,
   "t1": 9.81,
   "text": "это «слепота"
  },
  {
   "t0": 9.81,
   "t1": 10.671,
   "text": "ко времени»."
  },
  {
   "t0": 10.671,
   "t1": 11.612,
   "text": "Так часто бывает"
  },
  {
   "t0": 11.612,
   "t1": 12.343,
   "text": "при СДВГ."
  },
  {
   "t0": 12.343,
   "t1": 13.23,
   "text": "И без диагноза"
  },
  {
   "t0": 13.23,
   "t1": 13.795,
   "text": "тоже."
  },
  {
   "t0": 13.795,
   "t1": 14.619,
   "text": "Одного таймера"
  },
  {
   "t0": 14.619,
   "t1": 15.414,
   "text": "тут мало."
  },
  {
   "t0": 15.414,
   "t1": 16.238,
   "text": "Что помогает —"
  },
  {
   "t0": 16.238,
   "t1": 16.868,
   "text": "покажу."
  },
  {
   "t0": 16.868,
   "t1": 17.456,
   "text": "Интересное"
  },
  {
   "t0": 17.456,
   "t1": 18.22,
   "text": "съедает вечер"
  },
  {
   "t0": 18.22,
   "t1": 19.081,
   "text": "за минуту."
  },
  {
   "t0": 19.081,
   "t1": 19.672,
   "text": "А скучное"
  },
  {
   "t0": 19.672,
   "t1": 20.614,
   "text": "тянется вечность."
  },
  {
   "t0": 20.614,
   "t1": 21.601,
   "text": "Но вот ловушка:"
  },
  {
   "t0": 21.601,
   "t1": 22.462,
   "text": "ставишь таймер."
  },
  {
   "t0": 22.462,
   "t1": 23.258,
   "text": "Он звенит."
  },
  {
   "t0": 23.258,
   "t1": 24.658,
   "text": "Выключаешь…"
  },
  {
   "t0": 24.658,
   "t1": 25.584,
   "text": "и продолжаешь."
  },
  {
   "t0": 25.584,
   "t1": 26.445,
   "text": "Таймер звенит."
  },
  {
   "t0": 26.445,
   "t1": 27.201,
   "text": "Но не сидит"
  },
  {
   "t0": 27.201,
   "t1": 27.767,
   "text": "рядом."
  },
  {
   "t0": 27.767,
   "t1": 28.473,
   "text": "Многим легче,"
  },
  {
   "t0": 28.473,
   "t1": 29.12,
   "text": "когда рядом"
  },
  {
   "t0": 29.12,
   "t1": 29.915,
   "text": "кто-то есть."
  },
  {
   "t0": 29.915,
   "t1": 30.637,
   "text": "Это называют"
  },
  {
   "t0": 30.637,
   "t1": 31.342,
   "text": "боди-даблинг."
  },
  {
   "t0": 31.342,
   "t1": 32.229,
   "text": "Даже если этот"
  },
  {
   "t0": 32.229,
   "t1": 32.818,
   "text": "«кто-то» —"
  },
  {
   "t0": 32.818,
   "t1": 33.524,
   "text": "нарисованный"
  },
  {
   "t0": 33.524,
   "t1": 34.024,
   "text": "кот."
  },
  {
   "t0": 34.024,
   "t1": 34.729,
   "text": "«Напарник» —"
  },
  {
   "t0": 34.729,
   "t1": 35.35,
   "text": "кот рядом,"
  },
  {
   "t0": 35.35,
   "t1": 36.237,
   "text": "пока ты делаешь"
  },
  {
   "t0": 36.237,
