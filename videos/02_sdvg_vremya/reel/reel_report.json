  },
  {
   "t0": 9.708,
   "t1": 10.59,
   "text": "Психолог Рассел"
  },
  {
   "t0": 10.59,
   "t1": 11.472,
   "text": "Баркли называет"
  },
  {
   "t0": 11.472,
   "t1": 11.972,
   "text": "это"
  },
  {
   "t0": 11.972,
   "t1": 12.502,
   "text": "«слепотой"
  },
  {
   "t0": 12.502,
   "t1": 13.863,
   "text": "ко времени»."
  },
  {
   "t0": 13.863,
   "t1": 14.686,
   "text": "Одного таймера"
  },
  {
   "t0": 14.686,
   "t1": 15.481,
   "text": "тут мало."
  },
  {
   "t0": 15.481,
   "t1": 16.305,
   "text": "Что помогает —"
  },
  {
   "t0": 16.305,
   "t1": 16.935,
   "text": "покажу."
  },
  {
   "t0": 16.935,
   "t1": 17.523,
   "text": "Интересное"
  },
  {
   "t0": 17.523,
   "t1": 18.288,
   "text": "съедает вечер"
  },
  {
   "t0": 18.288,
   "t1": 19.149,
   "text": "за минуту."
  },
  {
   "t0": 19.149,
   "t1": 19.74,
   "text": "А скучное"
  },
  {
   "t0": 19.74,
   "t1": 20.681,
   "text": "тянется вечность."
  },
  {
   "t0": 20.681,
   "t1": 21.668,
   "text": "Но вот ловушка:"
  },
  {
   "t0": 21.668,
   "t1": 22.529,
   "text": "ставишь таймер."
  },
  {
   "t0": 22.529,
   "t1": 23.325,
   "text": "Он звенит."
  },
  {
   "t0": 23.325,
   "t1": 24.725,
   "text": "Выключаешь…"
  },
  {
   "t0": 24.725,
   "t1": 25.651,
   "text": "и продолжаешь."
  },
  {
   "t0": 25.651,
   "t1": 26.18,
   "text": "Но таймер"
  },
  {
   "t0": 26.18,
   "t1": 27.271,
   "text": "не сидит рядом."
  },
  {
   "t0": 27.271,
   "t1": 27.977,
   "text": "Многим легче,"
  },
  {
   "t0": 27.977,
   "t1": 28.624,
   "text": "когда рядом"
  },
  {
   "t0": 28.624,
   "t1": 29.419,
   "text": "кто-то есть."
  },
  {
   "t0": 29.419,
   "t1": 29.949,
   "text": "Хоть друг"
  },
  {
   "t0": 29.949,
   "t1": 30.81,
   "text": "по видео."
  },
  {
   "t0": 30.81,
   "t1": 31.532,
   "text": "Это называют"
  },
  {
   "t0": 31.532,
   "t1": 32.727,
   "text": "боди-даблинг."
  },
  {
   "t0": 32.727,
   "t1": 33.614,
   "text": "Даже если этот"
  },
  {
   "t0": 33.614,
   "t1": 34.202,
   "text": "«кто-то» —"
  },
  {
   "t0": 34.202,
   "t1": 35.193,
   "text": "нарисованный"
  },
  {
   "t0": 35.193,
   "t1": 35.693,
   "text": "кот."
  },
  {
   "t0": 35.693,
   "t1": 36.281,
   "text": "«Напарник»"
  },
  {
   "t0": 36.281,
   "t1": 37.077,
   "text": "не лечит."
  },
  {
   "t0": 37.077,
   "t1": 37.665,
   "text": "Просто кот"
  },
  {
   "t0": 37.665,
   "t1": 38.165,
   "text": "рядом,"
  },
  {
   "t0": 38.165,
   "t1": 39.052,
   "text": "пока ты делаешь"
  },
  {
   "t0": 39.052,
   "t1": 39.617,
   "text": "дело."
  },
  {
   "t0": 39.617,
   "t1": 40.323,
   "text": "Отправь тому,"
  },
  {
   "t0": 40.323,
   "t1": 41.01,
   "text": "кто думает,"
  },
  {
   "t0": 41.01,
   "t1": 42.102,
   "text": "что ты ленишься."
  },
  {
   "t0": 42.102,
   "t1": 42.602,
   "text": "Ссылка —"
  },
  {
   "t0": 42.602,
   "t1": 43.398,
   "text": "в шапке."
  },
  {
   "t0": 43.398,
   "t1": 44.028,
   "text": "Бесплатно."
  },
  {
   "t0": 44.028,
   "t1": 44.85,
   "text": "Начни с пяти"
  },
  {
   "t0": 44.85,
   "t1": 45.415,
   "text": "минут."
  },
  {
   "t0": 45.415,
   "t1": 46.482,
   "text": "Настоящих."
  }
 ]
