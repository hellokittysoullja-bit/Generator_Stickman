 "captions": [
  {
   "t0": 0.183,
   "t1": 0.874,
   "text": "Ты сказал:"
  },
  {
   "t0": 0.874,
   "t1": 2.07,
   "text": "«ещё пять минут»…"
  },
  {
   "t0": 2.07,
   "t1": 2.826,
   "text": "а за окном"
  },
  {
   "t0": 2.826,
   "t1": 3.622,
   "text": "уже ночь."
  },
  {
   "t0": 3.622,
   "t1": 4.148,
   "text": "Это не"
  },
  {
   "t0": 4.148,
   "t1": 4.648,
   "text": "лень."
  },
  {
   "t0": 4.648,
   "t1": 5.009,
   "text": "Психолог"
  },
  {
   "t0": 5.009,
   "t1": 5.6,
   "text": "Рассел Баркли"
  },
  {
   "t0": 5.6,
   "t1": 6.322,
   "text": "называет это"
  },
  {
   "t0": 6.322,
   "t1": 7.544,
   "text": "«слепотой ко времени»."
  },
  {
   "t0": 7.544,
   "t1": 8.366,
   "text": "Так бывает при"
  },
  {
   "t0": 8.366,
   "t1": 8.866,
   "text": "СДВГ."
  },
  {
   "t0": 8.866,
   "t1": 9.892,
   "text": "И не только."
  },
  {
   "t0": 9.892,
   "t1": 10.548,
   "text": "Почему таймер"
  },
  {
   "t0": 10.548,
   "t1": 11.253,
   "text": "не спасает —"
  },
  {
   "t0": 11.253,
   "t1": 12.344,
   "text": "и что спасает."
  },
  {
   "t0": 12.344,
   "t1": 13.14,
   "text": "В конце."
  },
  {
   "t0": 13.14,
   "t1": 14.026,
   "text": "Для такого мозга"
  },
  {
   "t0": 14.026,
   "t1": 14.553,
   "text": "есть только"
  },
  {
   "t0": 14.553,
   "t1": 15.222,
   "text": "«сейчас»…"
  },
  {
   "t0": 15.222,
   "t1": 16.248,
   "text": "и «не сейчас»."
  },
  {
   "t0": 16.248,
   "t1": 17.174,
   "text": "Середины нет."
  },
  {
   "t0": 17.174,
   "t1": 18.026,
   "text": "Интересное съедает"
  },
  {
   "t0": 18.026,
   "t1": 18.553,
   "text": "вечер за"
  },
  {
   "t0": 18.553,
   "t1": 19.183,
   "text": "минуту."
  },
  {
   "t0": 19.183,
   "t1": 19.905,
   "text": "Скучное тянется"
  },
  {
   "t0": 19.905,
   "t1": 20.47,
   "text": "вечность."
  },
  {
   "t0": 20.47,
   "t1": 21.331,
   "text": "Ставишь таймер."
  },
  {
   "t0": 21.331,
   "t1": 22.126,
   "text": "Он звенит."
  },
  {
   "t0": 22.126,
   "t1": 23.757,
   "text": "Ты выключаешь…"
  },
  {
   "t0": 23.757,
   "t1": 24.683,
   "text": "и продолжаешь."
  },
  {
   "t0": 24.683,
   "t1": 25.505,
   "text": "Таймер ждёт твоей"
  },
  {
   "t0": 25.505,
   "t1": 26.2,
   "text": "дисциплины."
  },
  {
   "t0": 26.2,
   "t1": 26.922,
   "text": "Многим помогает"
  },
  {
   "t0": 26.922,
   "t1": 27.448,
   "text": "другое:"
  },
  {
   "t0": 27.448,
   "t1": 28.04,
   "text": "когда рядом"
  },
  {
   "t0": 28.04,
   "t1": 28.835,
   "text": "кто-то есть."
  },
  {
   "t0": 28.835,
   "t1": 29.722,
   "text": "Тогда время снова"
  },
  {
   "t0": 29.722,
   "t1": 30.287,
   "text": "видно."
  },
  {
   "t0": 30.287,
   "t1": 31.287,
   "text": "Даже если это —"
  },
  {
   "t0": 31.287,
   "t1": 32.279,
   "text": "нарисованный кот."
  },
  {
   "t0": 32.279,
   "t1": 32.935,
   "text": "Так работает"
  },
  {
   "t0": 32.935,
   "t1": 33.461,
   "text": "«Напарник»:"
  },
  {
   "t0": 33.461,
   "t1": 34.083,
   "text": "кот рядом,"
  },
  {
   "t0": 34.083,
   "t1": 34.97,
   "text": "пока ты делаешь"
  },
  {
   "t0": 34.97,
   "t1": 35.535,
   "text": "дело."
  },
  {
   "t0": 35.535,
   "t1": 35.992,
   "text": "Бесплатно,"
  },
  {
   "t0": 35.992,
   "t1": 36.983,
   "text": "без регистрации."
  },
  {
   "t0": 36.983,
   "t1": 37.392,
   "text": "Ссылка —"
  },
  {
   "t0": 37.392,
   "t1": 38.187,
   "text": "в шапке."
  },
  {
   "t0": 38.187,
   "t1": 38.713,
   "text": "Начни с"
  },
  {
   "t0": 38.713,
   "t1": 39.574,
   "text": "пяти минут."
  },
  {
   "t0": 39.574,
   "t1": 40.641,
   "text": "Настоящих."
  }
