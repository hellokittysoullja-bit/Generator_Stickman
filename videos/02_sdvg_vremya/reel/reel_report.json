  },
  {
   "t0": 16.435,
   "t1": 17.023,
   "text": "Интересное"
  },
  {
   "t0": 17.023,
   "t1": 17.788,
   "text": "съедает вечер"
  },
  {
   "t0": 17.788,
   "t1": 18.649,
   "text": "за минуту."
  },
  {
   "t0": 18.649,
   "t1": 19.24,
   "text": "А скучное"
  },
  {
   "t0": 19.24,
   "t1": 20.181,
   "text": "тянется вечность."
  },
  {
   "t0": 20.181,
   "t1": 21.168,
   "text": "Но вот ловушка:"
  },
  {
   "t0": 21.168,
   "t1": 22.029,
   "text": "ставишь таймер."
  },
  {
   "t0": 22.029,
   "t1": 22.825,
   "text": "Он звенит."
  },
  {
   "t0": 22.825,
   "t1": 24.225,
   "text": "Выключаешь…"
  },
  {
   "t0": 24.225,
   "t1": 25.151,
   "text": "и продолжаешь."
  },
  {
   "t0": 25.151,
   "t1": 26.012,
   "text": "Таймер звенит."
  },
  {
   "t0": 26.012,
   "t1": 26.768,
   "text": "Но не сидит"
  },
  {
   "t0": 26.768,
   "t1": 27.334,
   "text": "рядом."
  },
  {
   "t0": 27.334,
   "t1": 28.04,
   "text": "Многим легче,"
  },
  {
   "t0": 28.04,
   "t1": 28.687,
   "text": "когда рядом"
  },
  {
   "t0": 28.687,
   "t1": 29.483,
   "text": "кто-то есть."
  },
  {
   "t0": 29.483,
   "t1": 30.204,
   "text": "Это называют"
  },
  {
   "t0": 30.204,
   "t1": 30.91,
   "text": "боди-даблинг."
  },
  {
   "t0": 30.91,
   "t1": 31.797,
   "text": "Даже если этот"
  },
  {
   "t0": 31.797,
   "t1": 32.385,
   "text": "«кто-то» —"
  },
  {
   "t0": 32.385,
   "t1": 33.376,
   "text": "нарисованный"
  },
  {
   "t0": 33.376,
   "t1": 33.876,
   "text": "кот."
  },
  {
   "t0": 33.876,
   "t1": 34.582,
   "text": "«Напарник» —"
  },
  {
   "t0": 34.582,
   "t1": 35.204,
   "text": "кот рядом,"
  },
  {
   "t0": 35.204,
   "t1": 36.09,
   "text": "пока ты делаешь"
  },
  {
   "t0": 36.09,
   "t1": 36.656,
   "text": "дело."
  },
  {
   "t0": 36.656,
   "t1": 37.362,
   "text": "Отправь тому,"
  },
  {
   "t0": 37.362,
   "t1": 38.049,
   "text": "кто думает,"
  },
  {
   "t0": 38.049,
   "t1": 39.14,
   "text": "что ты ленишься."
  },
  {
   "t0": 39.14,
   "t1": 39.64,
   "text": "Ссылка —"
  },
  {
   "t0": 39.64,
   "t1": 40.435,
   "text": "в шапке."
  },
  {
   "t0": 40.435,
   "t1": 41.066,
   "text": "Бесплатно."
  },
  {
   "t0": 41.066,
   "t1": 41.887,
   "text": "Начни с пяти"
  },
  {
   "t0": 41.887,
   "t1": 42.453,
   "text": "минут."
  },
  {
   "t0": 42.453,
   "t1": 43.519,
   "text": "Настоящих."
  }
 ]
