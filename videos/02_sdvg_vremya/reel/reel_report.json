 "captions": [
  {
   "t0": 0.183,
   "t1": 1.65,
   "text": "Ты не ленишься."
  },
  {
   "t0": 1.65,
   "t1": 2.407,
   "text": "Ты не видишь"
  },
  {
   "t0": 2.407,
   "t1": 2.972,
   "text": "время."
  },
  {
   "t0": 2.972,
   "t1": 3.501,
   "text": "«Ещё пять"
  },
  {
   "t0": 3.501,
   "t1": 4.171,
   "text": "минут»…"
  },
  {
   "t0": 4.171,
   "t1": 5.197,
   "text": "а уже ночь."
  },
  {
   "t0": 5.197,
   "t1": 5.723,
   "text": "А дело"
  },
  {
   "t0": 5.723,
   "t1": 6.584,
   "text": "не начато."
  },
  {
   "t0": 6.584,
   "t1": 7.467,
   "text": "Психолог Рассел"
  },
  {
   "t0": 7.467,
   "t1": 8.349,
   "text": "Баркли называет"
  },
  {
   "t0": 8.349,
   "t1": 8.849,
   "text": "это"
  },
  {
   "t0": 8.849,
   "t1": 9.379,
   "text": "«слепотой"
  },
  {
   "t0": 9.379,
   "t1": 10.239,
   "text": "ко времени»."
  },
  {
   "t0": 10.239,
   "t1": 11.18,
   "text": "Так часто бывает"
  },
  {
   "t0": 11.18,
   "t1": 11.911,
   "text": "при СДВГ."
  },
  {
   "t0": 11.911,
   "t1": 12.798,
   "text": "И без диагноза"
  },
  {
   "t0": 12.798,
   "t1": 13.363,
   "text": "тоже."
  },
  {
   "t0": 13.363,
   "t1": 14.186,
   "text": "Одного таймера"
  },
  {
   "t0": 14.186,
   "t1": 14.981,
   "text": "тут мало."
  },
  {
   "t0": 14.981,
   "t1": 15.805,
   "text": "Что помогает —"
  },
  {
   "t0": 15.805,
   "t1": 16.435,
   "text": "покажу."
  },
  {
   "t0": 16.435,
   "t1": 17.023,
   "text": "Интересное"
  },
  {
   "t0": 17.023,
   "t1": 17.788,
   "text": "съедает вечер"
  },
  {
   "t0": 17.788,
   "t1": 18.649,
   "text": "за минуту."
  },
  {
   "t0": 18.649,
   "t1": 19.24,
   "text": "А скучное"
  },
  {
   "t0": 19.24,
   "t1": 20.181,
   "text": "тянется вечность."
  },
  {
   "t0": 20.181,
   "t1": 21.168,
   "text": "Но вот ловушка:"
  },
  {
   "t0": 21.168,
   "t1": 22.029,
   "text": "ставишь таймер."
  },
  {
   "t0": 22.029,
   "t1": 22.825,
   "text": "Он звенит."
  },
  {
   "t0": 22.825,
   "t1": 24.225,
   "text": "Выключаешь…"
  },
  {
   "t0": 24.225,
   "t1": 25.151,
   "text": "и продолжаешь."
  },
  {
   "t0": 25.151,
   "t1": 26.012,
   "text": "Таймер звенит."
  },
  {
   "t0": 26.012,
   "t1": 26.768,
   "text": "Но не сидит"
  },
  {
   "t0": 26.768,
   "t1": 27.334,
   "text": "рядом."
  },
  {
   "t0": 27.334,
   "t1": 28.04,
   "text": "Многим легче,"
  },
  {
   "t0": 28.04,
   "t1": 28.687,
   "text": "когда рядом"
  },
  {
   "t0": 28.687,
   "t1": 29.483,
   "text": "кто-то есть."
  },
  {
   "t0": 29.483,
   "t1": 30.204,
   "text": "Это называют"
  },
  {
   "t0": 30.204,
   "t1": 30.91,
   "text": "боди-даблинг."
  },
  {
   "t0": 30.91,
   "t1": 31.797,
   "text": "Даже если этот"
  },
  {
   "t0": 31.797,
   "t1": 32.385,
   "text": "«кто-то» —"
  },
  {
   "t0": 32.385,
   "t1": 33.091,
   "text": "нарисованный"
  },
  {
   "t0": 33.091,
   "t1": 33.591,
   "text": "кот."
  },
  {
   "t0": 33.591,
   "t1": 34.297,
