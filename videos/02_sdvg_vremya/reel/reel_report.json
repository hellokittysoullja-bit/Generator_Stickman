  {
   "t0": 2.407,
   "t1": 2.972,
   "text": "время."
  },
  {
   "t0": 2.972,
   "t1": 3.913,
   "text": "Так часто бывает"
  },
  {
   "t0": 3.913,
   "t1": 4.643,
   "text": "при СДВГ."
  },
  {
   "t0": 4.643,
   "t1": 5.53,
   "text": "И без диагноза"
  },
  {
   "t0": 5.53,
   "t1": 6.096,
   "text": "тоже."
  },
  {
   "t0": 6.096,
   "t1": 6.626,
   "text": "«Ещё пять"
  },
  {
   "t0": 6.626,
   "t1": 7.295,
   "text": "минут»…"
  },
  {
   "t0": 7.295,
   "t1": 8.321,
   "text": "а уже ночь."
  },
  {
   "t0": 8.321,
   "t1": 8.847,
   "text": "А дело"
  },
  {
   "t0": 8.847,
   "t1": 9.708,
   "text": "не начато."
  },
  {
   "t0": 9.708,
   "t1": 10.59,
   "text": "Психолог Рассел"
  },
  {
   "t0": 10.59,
   "t1": 11.472,
   "text": "Баркли называет"
  },
  {
   "t0": 11.472,
   "t1": 11.972,
   "text": "это"
  },
  {
   "t0": 11.972,
   "t1": 12.502,
   "text": "«слепотой"
  },
  {
   "t0": 12.502,
   "t1": 13.863,
   "text": "ко времени»."
  },
  {
   "t0": 13.863,
   "t1": 14.686,
   "text": "Одного таймера"
  },
  {
   "t0": 14.686,
   "t1": 15.481,
   "text": "тут мало."
  },
  {
   "t0": 15.481,
   "t1": 16.305,
   "text": "Что помогает —"
  },
  {
   "t0": 16.305,
   "t1": 16.935,
   "text": "покажу."
  },
  {
   "t0": 16.935,
   "t1": 17.523,
   "text": "Интересное"
  },
  {
   "t0": 17.523,
   "t1": 18.288,
   "text": "съедает вечер"
  },
  {
   "t0": 18.288,
   "t1": 19.149,
   "text": "за минуту."
  },
  {
   "t0": 19.149,
   "t1": 19.74,
   "text": "А скучное"
  },
  {
   "t0": 19.74,
   "t1": 20.681,
   "text": "тянется вечность."
  },
  {
   "t0": 20.681,
   "t1": 21.668,
   "text": "Но вот ловушка:"
  },
  {
   "t0": 21.668,
   "t1": 22.529,
   "text": "ставишь таймер."
  },
  {
   "t0": 22.529,
   "t1": 23.325,
   "text": "Он звенит."
  },
  {
   "t0": 23.325,
   "t1": 24.725,
   "text": "Выключаешь…"
  },
  {
   "t0": 24.725,
   "t1": 25.651,
   "text": "и продолжаешь."
  },
  {
   "t0": 25.651,
   "t1": 26.512,
   "text": "Таймер звенит."
  },
  {
   "t0": 26.512,
   "t1": 27.268,
   "text": "Но не сидит"
  },
  {
   "t0": 27.268,
   "t1": 27.834,
   "text": "рядом."
  },
  {
   "t0": 27.834,
   "t1": 28.54,
   "text": "Многим легче,"
  },
  {
   "t0": 28.54,
   "t1": 29.187,
   "text": "когда рядом"
  },
  {
   "t0": 29.187,
   "t1": 29.983,
   "text": "кто-то есть."
  },
  {
   "t0": 29.983,
   "t1": 30.704,
   "text": "Это называют"
  },
  {
   "t0": 30.704,
   "t1": 31.9,
   "text": "боди-даблинг."
  },
  {
   "t0": 31.9,
   "t1": 32.787,
   "text": "Даже если этот"
  },
  {
   "t0": 32.787,
   "t1": 33.375,
   "text": "«кто-то» —"
  },
  {
   "t0": 33.375,
   "t1": 34.366,
   "text": "нарисованный"
  },
  {
   "t0": 34.366,
   "t1": 34.866,
   "text": "кот."
  },
  {
   "t0": 34.866,
   "t1": 35.572,
   "text": "«Напарник» —"
  },
  {
   "t0": 35.572,
   "t1": 36.194,
   "text": "кот рядом,"
  },
  {
   "t0": 36.194,
   "t1": 37.08,
   "text": "пока ты делаешь"
  },
  {
   "t0": 37.08,
   "t1": 37.646,
   "text": "дело."
  },
  {
   "t0": 37.646,
   "t1": 38.352,
   "text": "Отправь тому,"
  },
  {
   "t0": 38.352,
   "t1": 39.039,
   "text": "кто думает,"
  },
  {
   "t0": 39.039,
   "t1": 40.13,
   "text": "что ты ленишься."
  },
  {
   "t0": 40.13,
   "t1": 40.63,
   "text": "Ссылка —"
  },
  {
   "t0": 40.63,
   "t1": 41.425,
   "text": "в шапке."
  },
  {
   "t0": 41.425,
   "t1": 42.056,
   "text": "Бесплатно."
  },
  {
   "t0": 42.056,
   "t1": 42.877,
   "text": "Начни с пяти"
  },
  {
   "t0": 42.877,
   "t1": 43.443,
   "text": "минут."
  },
  {
   "t0": 43.443,
   "t1": 44.509,
   "text": "Настоящих."
