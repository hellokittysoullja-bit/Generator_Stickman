 "captions": [
  {
   "t0": 0.0,
   "t1": 0.48,
   "text": "Отложишь дело,"
  },
  {
   "t0": 0.48,
   "t1": 1.787,
   "text": "и тебе легче?"
  },
  {
   "t0": 1.787,
   "t1": 2.467,
   "text": "Убираешь дело"
  },
  {
   "t0": 2.467,
   "t1": 3.187,
   "text": "на завтра,"
  },
  {
   "t0": 3.187,
   "t1": 4.496,
   "text": "и отпускает,"
  },
  {
   "t0": 4.496,
   "t1": 5.267,
   "text": "а вот ночью"
  },
  {
   "t0": 5.267,
   "t1": 6.427,
   "text": "оно грызёт."
  },
  {
   "t0": 6.427,
   "t1": 7.387,
   "text": "В конце покажу,"
  },
  {
   "t0": 7.387,
   "t1": 7.747,
   "text": "как не"
  },
  {
   "t0": 7.747,
   "t1": 8.907,
   "text": "отложить снова."
  },
  {
   "t0": 8.907,
   "t1": 9.627,
   "text": "Я так отложил"
  },
  {
   "t0": 9.627,
   "t1": 10.467,
   "text": "звонок врачу"
  },
  {
   "t0": 10.467,
   "t1": 11.467,
   "text": "и неделю ругал"
  },
  {
