 "captions": [
  {
   "t0": 0.0,
   "t1": 0.413,
   "text": "Опять"
  },
  {
   "t0": 0.413,
   "t1": 1.73,
   "text": "с понедельника?"
  },
  {
   "t0": 1.73,
   "t1": 2.29,
   "text": "А к среде"
  },
  {
   "t0": 2.29,
   "t1": 3.17,
   "text": "всё бросишь."
  },
  {
   "t0": 3.17,
   "t1": 4.05,
   "text": "В конце покажу,"
  },
  {
   "t0": 4.05,
   "t1": 4.65,
   "text": "как начать"
  },
  {
   "t0": 4.65,
   "t1": 5.25,
   "text": "без него,"
  },
  {
   "t0": 5.25,
   "t1": 5.81,
   "text": "и дело не"
  },
  {
   "t0": 5.81,
   "t1": 6.93,
   "text": "в силе воли."
  },
  {
   "t0": 6.93,
   "t1": 7.65,
   "text": "Я так прожил"
  },
  {
   "t0": 7.65,
   "t1": 8.77,
   "text": "три понедельника:"
  },
  {
   "t0": 8.77,
   "t1": 9.65,
   "text": "новая жизнь,"
  },
  {
   "t0": 9.65,
   "t1": 9.81,
   "text": "а в"
  },
  {
   "t0": 9.81,
   "t1": 10.877,
   "text": "среду срыв."
  },
  {
   "t0": 10.877,
   "t1": 11.29,
   "text": "Учёная"
  },
  {
   "t0": 11.29,
   "t1": 12.13,
   "text": "Кэти Милкман"
  },
  {
   "t0": 12.13,
   "t1": 13.25,
   "text": "нашла ловушку:"
  },
  {
   "t0": 13.25,
   "t1": 14.17,
