 "captions": [
  {
   "t0": 0.0,
   "t1": 0.373,
   "text": "Опять"
  },
  {
   "t0": 0.373,
   "t1": 1.856,
   "text": "с понедельника?"
  },
  {
   "t0": 1.856,
   "t1": 2.416,
   "text": "А к среде"
  },
  {
   "t0": 2.416,
   "t1": 3.593,
   "text": "всё бросишь,"
  },
  {
   "t0": 3.593,
   "t1": 4.096,
   "text": "и дело не"
  },
  {
   "t0": 4.096,
   "t1": 5.109,
   "text": "в силе воли."
  },
  {
   "t0": 5.109,
   "t1": 6.096,
   "text": "В конце покажу,"
  },
  {
   "t0": 6.096,
   "t1": 7.136,
   "text": "как начать"
  },
  {
   "t0": 7.136,
   "t1": 8.176,
   "text": "без него."
  },
  {
   "t0": 8.176,
   "t1": 8.976,
   "text": "Я так прожил"
  },
  {
   "t0": 8.976,
   "t1": 10.176,
   "text": "три понедельника:"
  },
  {
   "t0": 10.176,
   "t1": 11.056,
   "text": "новая жизнь,"
  },
  {
