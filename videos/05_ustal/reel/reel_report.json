 "captions": [
  {
   "t0": 0.0,
   "t1": 1.65,
   "text": "Лежал и устал."
  },
  {
   "t0": 1.65,
   "t1": 2.17,
   "text": "И отдых"
  },
  {
   "t0": 2.17,
   "t1": 3.25,
   "text": "тут не поможет,"
  },
  {
   "t0": 3.25,
   "t1": 4.53,
   "text": "сколько ни лежи."
  },
  {
   "t0": 4.53,
   "t1": 5.77,
   "text": "Ничего не делал,"
  },
  {
   "t0": 5.77,
   "t1": 7.01,
   "text": "а сил нет."
  },
  {
   "t0": 7.01,
   "t1": 7.57,
   "text": "Потому что"
  },
  {
   "t0": 7.57,
   "t1": 8.57,
   "text": "дело висело,"
  },
  {
   "t0": 8.57,
   "t1": 8.93,
   "text": "и ты"
  },
  {
   "t0": 8.93,
   "t1": 9.97,
   "text": "весь день носил"
  },
  {
   "t0": 9.97,
   "t1": 11.09,
   "text": "его в голове."
  },
  {
   "t0": 11.09,
