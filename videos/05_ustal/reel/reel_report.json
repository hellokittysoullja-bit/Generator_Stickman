 "captions": [
  {
   "t0": 0.0,
   "t1": 1.65,
   "text": "Лежал и устал."
  },
  {
   "t0": 1.65,
   "t1": 2.89,
   "text": "Ничего не делал,"
  },
  {
   "t0": 2.89,
   "t1": 4.13,
   "text": "а сил нет."
  },
  {
   "t0": 4.13,
   "t1": 4.69,
   "text": "Потому что"
  },
  {
   "t0": 4.69,
   "t1": 5.69,
   "text": "дело висело,"
  },
  {
   "t0": 5.69,
   "t1": 6.05,
   "text": "и ты"
  },
  {
   "t0": 6.05,
   "t1": 7.09,
   "text": "весь день носил"
  },
  {
   "t0": 7.09,
   "t1": 8.21,
   "text": "его в голове."
  },
  {
   "t0": 8.21,
   "t1": 8.93,
   "text": "Это как держать"
  },
  {
   "t0": 8.93,
   "t1": 9.65,
   "text": "стакан воды"
  },
  {
   "t0": 9.65,
   "t1": 11.01,
   "text": "на вытянутой руке:"
  },
  {
   "t0": 11.01,
   "t1": 11.77,
   "text": "он лёгкий,"
  },
  {
   "t0": 11.77,
   "t1": 12.53,
   "text": "а через час"
  },
  {
   "t0": 12.53,
   "t1": 13.89,
   "text": "рука отваливается."
  },
  {
   "t0": 13.89,
   "t1": 14.263,
   "text": "У меня"
  },
  {
   "t0": 14.263,
   "t1": 15.17,
   "text": "тоже так."
  },
  {
   "t0": 15.17,
   "t1": 15.65,
   "text": "Я думал,"
  },
  {
   "t0": 15.65,
   "t1": 16.57,
   "text": "что ленюсь,"
  },
  {
   "t0": 16.57,
   "t1": 16.81,
   "text": "а я"
  },
  {
   "t0": 16.81,
   "t1": 17.81,
   "text": "был вымотан."
  },
  {
   "t0": 17.81,
   "t1": 18.41,
   "text": "И отдохнуть"
  },
  {
   "t0": 18.41,
   "t1": 19.25,
   "text": "не выходило,"
  },
  {
   "t0": 19.25,
   "t1": 20.13,
   "text": "потому что дело"
  },
  {
   "t0": 20.13,
   "t1": 21.49,
   "text": "всё время рядом."
  },
  {
   "t0": 21.49,
   "t1": 22.21,
   "text": "Но стакан"
  },
  {
   "t0": 22.21,
   "t1": 23.49,
   "text": "можно поставить."
  },
  {
   "t0": 23.49,
   "t1": 23.97,
   "text": "Я делал"
  },
  {
   "t0": 23.97,
   "t1": 24.61,
   "text": "с этим делом"
  },
  {
   "t0": 24.61,
   "t1": 25.97,
   "text": "что-то крошечное,"
  },
  {
   "t0": 25.97,
   "t1": 26.29,
   "text": "хотя бы"
  },
  {
   "t0": 26.29,
   "t1": 27.33,
   "text": "открывал его,"
  },
  {
   "t0": 27.33,
   "t1": 27.97,
   "text": "и голове"
  },
  {
   "t0": 27.97,
   "t1": 29.33,
   "text": "становилось легче."
  },
  {
   "t0": 29.33,
   "t1": 30.49,
   "text": "Напиши в комментах,"
  },
  {
