 "captions": [
  {
   "t0": 0.0,
   "t1": 1.787,
   "text": "Устаёшь от отдыха?"
  },
  {
   "t0": 1.787,
   "t1": 2.747,
   "text": "Лежишь весь день,"
  },
  {
   "t0": 2.747,
   "t1": 3.147,
   "text": "а сил"
  },
  {
   "t0": 3.147,
   "t1": 4.267,
   "text": "всё меньше?"
  },
  {
   "t0": 4.267,
   "t1": 4.627,
   "text": "Но это"
  },
  {
   "t0": 4.627,
   "t1": 5.107,
   "text": "не лень"
  },
  {
   "t0": 5.107,
   "t1": 6.067,
   "text": "и не недосып,"
  },
  {
   "t0": 6.067,
   "t1": 6.547,
   "text": "и снять"
  },
  {
   "t0": 6.547,
   "t1": 7.387,
   "text": "это можно"
  },
  {
   "t0": 7.387,
   "t1": 8.907,
   "text": "одной строчкой."
  },
  {
   "t0": 8.907,
   "t1": 9.907,
   "text": "Тебя выматывает"
  },
  {
   "t0": 9.907,
   "t1": 10.787,
   "text": "дело, которое"
  },
  {
   "t0": 10.787,
   "t1": 11.6,
   "text": "держишь в голове,"
  },
  {
   "t0": 11.6,
   "t1": 12.267,
   "text": "как стакан"
  },
  {
   "t0": 12.267,
   "t1": 13.587,
   "text": "на вытянутой руке."
  },
  {
   "t0": 13.587,
   "t1": 14.427,
   "text": "Он лёгкий,"
  },
  {
   "t0": 14.427,
   "t1": 15.147,
   "text": "а через час"
  },
  {
   "t0": 15.147,
   "t1": 16.587,
   "text": "рука отваливается."
  },
  {
   "t0": 16.587,
   "t1": 17.067,
   "text": "И я,"
  },
  {
   "t0": 17.067,
   "t1": 17.867,
   "text": "как и ты,"
  },
  {
   "t0": 17.867,
   "t1": 19.147,
   "text": "думал, что ленюсь."
  },
  {
   "t0": 19.147,
   "t1": 19.827,
   "text": "Поставить его"
  },
  {
   "t0": 19.827,
   "t1": 21.557,
   "text": "помогает строчка:"
  },
  {
   "t0": 21.557,
   "t1": 22.997,
   "text": "запиши, что сделаешь"
  },
  {
   "t0": 22.997,
   "t1": 23.837,
   "text": "и когда."
  },
  {
   "t0": 23.837,
   "t1": 24.517,
   "text": "Это проверили"
  },
  {
   "t0": 24.517,
   "t1": 25.117,
   "text": "психологи"
  },
  {
   "t0": 25.117,
   "t1": 25.877,
   "text": "Масикампо"
  },
  {
   "t0": 25.877,
   "t1": 27.077,
   "text": "и Баумайстер."
  },
  {
   "t0": 27.077,
   "t1": 27.997,
   "text": "В шапке профиля"
  },
  {
   "t0": 27.997,
   "t1": 28.717,
   "text": "я помогу тебе"
  },
  {
   "t0": 28.717,
   "t1": 29.917,
   "text": "начать твоё дело,"
  },
  {
   "t0": 29.917,
   "t1": 30.317,
   "text": "а также"
  },
  {
   "t0": 30.317,
   "t1": 31.117,
   "text": "посижу с тобой"
  },
  {
   "t0": 31.117,
   "t1": 31.677,
   "text": "пару минут,"
  },
  {
   "t0": 31.677,
   "t1": 32.837,
   "text": "пока ты начинаешь."
  },
  {
   "t0": 32.837,
   "t1": 33.797,
   "text": "Бесплатно."
  },
  {
   "t0": 33.797,
   "t1": 34.437,
   "text": "Смотри, что"
  },
  {
   "t0": 34.437,
   "t1": 35.437,
   "text": "было дальше."
  },
  {
   "t0": 35.437,
   "t1": 36.437,
   "text": "Я записал"
  },
  {
   "t0": 36.437,
   "t1": 37.197,
   "text": "«завтра в десять"
  },
  {
   "t0": 37.197,
   "t1": 38.437,
   "text": "открою письмо»,"
  },
  {
   "t0": 38.437,
   "t1": 38.957,
   "text": "а открыл"
  },
  {
   "t0": 38.957,
   "t1": 39.717,
   "text": "его тем же"
  },
  {
   "t0": 39.717,
   "t1": 40.744,
   "text": "вечером."
  }
 ]
