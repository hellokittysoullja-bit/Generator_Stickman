 "captions": [
  {
   "t0": 0.0,
   "t1": 1.519,
   "text": "Все успели, а ты?"
  },
  {
   "t0": 1.519,
   "t1": 2.279,
   "text": "Свадьбы,"
  },
  {
   "t0": 2.279,
   "t1": 4.079,
   "text": "поездки, повышения,"
  },
  {
   "t0": 4.079,
   "t1": 5.039,
   "text": "и дело совсем"
  },
  {
   "t0": 5.039,
   "t1": 5.519,
   "text": "не в том,"
  },
  {
   "t0": 5.519,
   "t1": 6.719,
   "text": "что ты медленнее."
  },
  {
   "t0": 6.719,
   "t1": 7.519,
   "text": "Но к концу"
  },
  {
   "t0": 7.519,
   "t1": 8.239,
   "text": "ты поймёшь,"
  },
  {
   "t0": 8.239,
   "t1": 8.759,
   "text": "где ты"
  },
  {
   "t0": 8.759,
   "t1": 10.079,
   "text": "на самом деле."
  },
  {
   "t0": 10.079,
   "t1": 10.959,
   "text": "Психолог Эрин"
  },
  {
   "t0": 10.959,
   "t1": 12.319,
   "text": "Фогель проверила:"
  },
  {
   "t0": 12.319,
   "t1": 12.799,
   "text": "от чужих"
  },
  {
   "t0": 12.799,
   "t1": 13.719,
   "text": "ярких страниц"
  },
  {
   "t0": 13.719,
   "t1": 14.759,
   "text": "тебе хуже."
  },
  {
   "t0": 14.759,
   "t1": 15.519,
   "text": "В ленте только"
  },
  {
   "t0": 15.519,
   "t1": 16.719,
   "text": "их лучшие кадры,"
  },
  {
   "t0": 16.719,
   "t1": 17.599,
   "text": "а свои будни"
  },
  {
   "t0": 17.599,
   "t1": 19.039,
   "text": "ты знаешь целиком."
  },
  {
   "t0": 19.039,
   "t1": 19.519,
   "text": "Я думал,"
  },
  {
   "t0": 19.519,
   "t1": 19.999,
   "text": "что стою"
  },
  {
   "t0": 19.999,
   "t1": 20.759,
   "text": "на месте,"
  },
  {
   "t0": 20.759,
   "t1": 21.439,
   "text": "пока не нашёл"
  },
  {
   "t0": 21.439,
   "t1": 22.479,
   "text": "фото прошлой зимы,"
  },
  {
   "t0": 22.479,
   "t1": 23.879,
   "text": "где боюсь письма."
  },
  {
   "t0": 23.879,
   "t1": 24.479,
   "text": "Сравни себя"
  },
  {
   "t0": 24.479,
   "t1": 25.419,
   "text": "с собой"
  },
  {
   "t0": 25.419,
   "t1": 26.419,
   "text": "год назад."
  },
  {
   "t0": 26.419,
   "t1": 26.699,
   "text": "Что ты"
  },
  {
   "t0": 26.699,
   "t1": 27.779,
   "text": "умеешь теперь?"
  },
  {
   "t0": 27.779,
   "t1": 28.819,
   "text": "Если чужие ленты"
  },
  {
   "t0": 28.819,
   "t1": 30.059,
   "text": "снова тянут вниз,"
  },
  {
   "t0": 30.059,
   "t1": 30.539,
   "text": "загляни в"
  },
  {
   "t0": 30.539,
   "t1": 31.539,
   "text": "шапку профиля,"
  },
  {
   "t0": 31.539,
   "t1": 32.539,
   "text": "в «Напарник»:"
  },
  {
   "t0": 32.539,
   "t1": 33.219,
   "text": "пара минут,"
  },
  {
   "t0": 33.219,
   "t1": 33.699,
   "text": "и видно"
  },
  {
   "t0": 33.699,
   "t1": 34.939,
   "text": "только твой путь."
  },
  {
   "t0": 34.939,
   "t1": 36.079,
   "text": "Бесплатно."
  },
  {
   "t0": 36.079,
   "t1": 36.439,
   "text": "И вот"
  },
  {
   "t0": 36.439,
   "t1": 37.679,
   "text": "что было потом."
  },
  {
   "t0": 37.679,
   "t1": 38.759,
   "text": "Сегодня я открыл"
  },
  {
   "t0": 38.759,
   "t1": 39.879,
   "text": "три письма подряд"
  },
  {
   "t0": 39.879,
   "t1": 40.599,
   "text": "и не заметил,"
  },
  {
   "t0": 40.599,
   "t1": 40.999,
   "text": "что было"
  },
  {
   "t0": 40.999,
   "t1": 42.146,
   "text": "страшно."
  }
 ]
}