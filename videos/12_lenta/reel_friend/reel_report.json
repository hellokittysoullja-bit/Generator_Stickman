 "captions": [
  {
   "t0": 0.0,
   "t1": 1.519,
   "text": "Все успели, а ты?"
  },
  {
   "t0": 1.519,
   "t1": 2.279,
   "text": "Свадьбы,"
  },
  {
   "t0": 2.279,
   "t1": 4.079,
   "text": "поездки, повышения,"
  },
  {
   "t0": 4.079,
   "t1": 5.119,
   "text": "и дело совсем"
  },
  {
   "t0": 5.119,
   "t1": 5.599,
   "text": "не в том,"
  },
  {
   "t0": 5.599,
   "t1": 6.799,
   "text": "что ты медленнее."
  },
  {
   "t0": 6.799,
   "t1": 7.039,
   "text": "Но в"
  },
  {
   "t0": 7.039,
   "t1": 7.959,
   "text": "конце покажу,"
  },
  {
   "t0": 7.959,
   "t1": 8.719,
   "text": "как увидеть,"
  },
  {
   "t0": 8.719,
   "t1": 9.199,
   "text": "где ты"
  },
  {
   "t0": 9.199,
   "t1": 10.559,
   "text": "на самом деле."
  },
  {
   "t0": 10.559,
   "t1": 11.439,
   "text": "Психолог Эрин"
  },
  {
   "t0": 11.439,
   "t1": 12.719,
   "text": "Фогель проверила:"
  },
  {
   "t0": 12.719,
   "t1": 13.279,
   "text": "от чужих"
  },
  {
   "t0": 13.279,
   "t1": 14.199,
   "text": "ярких страниц"
  },
  {
   "t0": 14.199,
   "t1": 15.199,
   "text": "тебе хуже."
  },
  {
   "t0": 15.199,
   "t1": 15.999,
   "text": "В ленте только"
  },
  {
   "t0": 15.999,
   "t1": 17.159,
   "text": "их лучшие кадры,"
  },
  {
   "t0": 17.159,
   "t1": 17.999,
   "text": "а свои будни"
  },
  {
   "t0": 17.999,
   "t1": 19.519,
   "text": "ты знаешь целиком."
  },
  {
   "t0": 19.519,
   "t1": 20.079,
   "text": "Я думал,"
  },
  {
   "t0": 20.079,
   "t1": 20.519,
   "text": "что стою"
  },
  {
   "t0": 20.519,
   "t1": 21.239,
   "text": "на месте,"
  },
  {
   "t0": 21.239,
   "t1": 21.919,
   "text": "пока не нашёл"
  },
  {
   "t0": 21.919,
   "t1": 22.999,
   "text": "фото прошлой зимы,"
  },
  {
   "t0": 22.999,
   "t1": 24.399,
   "text": "где боюсь письма."
  },
  {
   "t0": 24.399,
   "t1": 25.199,
   "text": "Сравни себя"
  },
  {
   "t0": 25.199,
   "t1": 26.139,
   "text": "с собой"
  },
  {
   "t0": 26.139,
   "t1": 27.099,
   "text": "год назад."
  },
  {
   "t0": 27.099,
   "t1": 27.419,
   "text": "Что ты"
  },
  {
   "t0": 27.419,
   "t1": 28.459,
   "text": "умеешь теперь?"
  },
  {
   "t0": 28.459,
   "t1": 29.459,
   "text": "Начни своё дело"
  },
  {
   "t0": 29.459,
   "t1": 30.459,
   "text": "вместе со мной,"
  },
  {
   "t0": 30.459,
   "t1": 30.899,
   "text": "ссылка в"
  },
  {
   "t0": 30.899,
   "t1": 31.979,
   "text": "шапке профиля."
  },
  {
   "t0": 31.979,
   "t1": 32.579,
   "text": "Я посижу"
  },
  {
   "t0": 32.579,
   "t1": 33.659,
   "text": "рядом пару минут."
  },
  {
   "t0": 33.659,
   "t1": 34.839,
   "text": "Бесплатно."
  },
  {
   "t0": 34.839,
   "t1": 35.399,
   "text": "А дальше"
  },
  {
   "t0": 35.399,
   "t1": 36.519,
   "text": "было вот что."
  },
  {
   "t0": 36.519,
   "t1": 37.639,
   "text": "Сегодня я открыл"
  },
  {
   "t0": 37.639,
   "t1": 38.839,
   "text": "три письма подряд"
  },
  {
   "t0": 38.839,
   "t1": 39.639,
   "text": "и не заметил,"
  },
  {
   "t0": 39.639,
   "t1": 40.039,
   "text": "что было"
  },
  {
   "t0": 40.039,
   "t1": 41.266,
   "text": "страшно."
  }
 ]
