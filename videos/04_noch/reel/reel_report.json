  },
  {
   "t0": 17.44,
   "t1": 18.8,
   "text": "себе лечь вовремя."
  },
  {
   "t0": 18.8,
   "t1": 19.08,
   "text": "Ночь"
  },
  {
   "t0": 19.08,
   "t1": 20.0,
   "text": "была единственным"
