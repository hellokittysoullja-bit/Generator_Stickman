 "captions": [
  {
   "t0": 0.0,
   "t1": 1.65,
   "text": "Опять не спишь?"
  },
  {
   "t0": 1.65,
   "t1": 2.57,
   "text": "День прошёл,"
  },
  {
   "t0": 2.57,
   "t1": 2.89,
   "text": "а ты"
  },
  {
   "t0": 2.89,
   "t1": 3.17,
   "text": "в нём"
  },
  {
   "t0": 3.17,
   "t1": 3.89,
   "text": "не был."
  },
  {
   "t0": 3.89,
   "t1": 5.33,
   "text": "Открыл одно видео,"
  },
  {
   "t0": 5.33,
   "t1": 6.57,
   "text": "потом ещё одно,"
  },
  {
   "t0": 6.57,
   "t1": 6.89,
   "text": "и вот"
  },
  {
   "t0": 6.89,
   "t1": 7.97,
   "text": "уже светает."
  },
  {
   "t0": 7.97,
   "t1": 8.45,
   "text": "А утром"
  },
  {
   "t0": 8.45,
   "t1": 9.41,
   "text": "злишься на себя,"
  },
  {
   "t0": 9.41,
   "t1": 9.93,
   "text": "что день"
  },
  {
   "t0": 9.93,
   "t1": 11.49,
   "text": "опять прошёл мимо."
  },
  {
   "t0": 11.49,
   "t1": 11.85,
   "text": "У меня"
  },
  {
   "t0": 11.85,
   "t1": 13.01,
   "text": "тоже так было."
  },
  {
   "t0": 13.01,
   "t1": 13.81,
   "text": "Я каждую"
  },
  {
   "t0": 13.81,
   "t1": 14.45,
   "text": "ночь обещал"
  },
  {
   "t0": 14.45,
   "t1": 15.81,
   "text": "себе лечь вовремя."
  },
  {
   "t0": 15.81,
   "t1": 16.69,
   "text": "Но телефон тут"
  },
  {
   "t0": 16.69,
   "t1": 17.89,
   "text": "не главный враг."
  },
  {
   "t0": 17.89,
   "t1": 18.17,
   "text": "Ночь"
  },
  {
   "t0": 18.17,
   "t1": 19.17,
   "text": "была единственным"
  },
  {
   "t0": 19.17,
   "t1": 19.69,
   "text": "временем,"
  },
  {
   "t0": 19.69,
   "t1": 20.37,
   "text": "когда от меня"
  },
  {
   "t0": 20.37,
   "t1": 21.21,
   "text": "никто ничего"
  },
  {
   "t0": 21.21,
   "t1": 21.97,
   "text": "не ждал."
  },
  {
   "t0": 21.97,
   "t1": 22.557,
   "text": "Поэтому я"
  },
  {
   "t0": 22.557,
   "t1": 23.01,
   "text": "и не мог"
  },
  {
   "t0": 23.01,
   "t1": 24.05,
   "text": "её отпустить."
  },
  {
   "t0": 24.05,
   "t1": 25.41,
   "text": "Сработало одно:"
  },
  {
   "t0": 25.41,
   "t1": 25.81,
   "text": "я стал"
  },
  {
   "t0": 25.81,
   "t1": 26.37,
   "text": "брать такой"
  },
  {
   "t0": 26.37,
   "t1": 28.05,
   "text": "кусок тишины днём."
  },
  {
   "t0": 28.05,
   "t1": 29.13,
   "text": "Напиши в комментах,"
  },
  {
   "t0": 29.13,
   "t1": 29.73,
   "text": "во сколько"
  },
  {
   "t0": 29.73,
   "t1": 31.09,
   "text": "ты сегодня уснёшь."
  },
  {
   "t0": 31.09,
   "t1": 31.93,
   "text": "И отправь тому,"
  },
  {
   "t0": 31.93,
   "t1": 32.53,
   "text": "кто тоже"
  },
  {
