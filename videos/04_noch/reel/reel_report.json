   "text": "станет только хуже."
  },
  {
   "t0": 4.88,
   "t1": 5.8,
   "text": "День прошёл,"
  },
  {
   "t0": 5.8,
   "t1": 6.04,
   "text": "а ты"
  },
  {
   "t0": 6.04,
   "t1": 6.32,
