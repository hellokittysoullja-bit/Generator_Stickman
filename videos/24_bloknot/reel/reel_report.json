 "captions": [
  {
   "t0": 0.0,
   "t1": 0.38,
   "text": "Купишь блокнот"
  },
  {
   "t0": 0.38,
   "t1": 0.88,
   "text": "и жалко"
  },
  {
   "t0": 0.88,
   "t1": 2.253,
   "text": "писать?"
  },
  {
   "t0": 2.253,
   "t1": 2.573,
   "text": "Лежит"
  },
  {
   "t0": 2.573,
   "t1": 3.586,
   "text": "стопка красивых,"
  },
  {
   "t0": 3.586,
   "t1": 3.933,
   "text": "и ни"
  },
  {
   "t0": 3.933,
   "t1": 5.213,
   "text": "одной строчки."
  },
  {
   "t0": 5.213,
   "t1": 5.613,
   "text": "Но дело"
  },
  {
   "t0": 5.613,
   "t1": 6.637,
   "text": "не в почерке,"
  },
  {
   "t0": 6.637,
   "t1": 7.853,
   "text": "в конце покажу,"
  },
  {
   "t0": 7.853,
   "t1": 9.293,
   "text": "как тебе начать."
  },
  {
   "t0": 9.293,
   "t1": 9.613,
   "text": "У меня"
  },
  {
   "t0": 9.613,
   "t1": 10.253,
   "text": "в ящике"
  },
  {
   "t0": 10.253,
   "t1": 11.213,
   "text": "пять блокнотов,"
  },
  {
   "t0": 11.213,
   "t1": 12.546,
   "text": "и все пустые."
  },
  {
   "t0": 12.546,
   "t1": 13.453,
   "text": "Знакомо?"
  },
  {
   "t0": 13.453,
   "t1": 13.893,
   "text": "Напиши в"
  },
  {
   "t0": 13.893,
   "t1": 14.706,
   "text": "комментах кот,"
  },
  {
   "t0": 14.706,
   "t1": 15.373,
   "text": "и Напарник"
  },
  {
   "t0": 15.373,
   "t1": 16.573,
   "text": "посидит с тобой."
  },
  {
   "t0": 16.573,
   "t1": 17.613,
   "text": "Чистая страница"
  },
  {
   "t0": 17.613,
   "t1": 18.813,
   "text": "кажется дороже,"
  },
  {
   "t0": 18.813,
   "t1": 19.773,
   "text": "и первая строчка"
  },
  {
   "t0": 19.773,
   "t1": 21.24,
   "text": "будто её испортит."
  },
  {
   "t0": 21.24,
   "t1": 22.333,
   "text": "Поэтому испорти"
  },
  {
   "t0": 22.333,
   "t1": 23.16,
   "text": "её сам:"
  },
  {
   "t0": 23.16,
   "t1": 24.093,
   "text": "на первой странице"
  },
  {
   "t0": 24.093,
   "t1": 25.913,
   "text": "нарисуй каракулю."
  },
  {
   "t0": 25.913,
   "t1": 26.513,
   "text": "Я нарисовал"
  },
  {
   "t0": 26.513,
   "t1": 27.433,
   "text": "кривого кота,"
  },
  {
   "t0": 27.433,
   "t1": 28.433,
   "text": "и дальше писалось"
  },
  {
   "t0": 28.433,
   "t1": 29.38,
   "text": "само."
  }
 ]
