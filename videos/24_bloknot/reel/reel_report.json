 "captions": [
  {
   "t0": 0.0,
   "t1": 0.38,
   "text": "Купишь блокнот"
  },
  {
   "t0": 0.38,
   "t1": 0.68,
   "text": "и жалко"
  },
  {
   "t0": 0.68,
   "t1": 1.853,
   "text": "писать?"
  },
  {
   "t0": 1.853,
   "t1": 2.173,
   "text": "Лежит"
  },
  {
   "t0": 2.173,
   "t1": 3.186,
   "text": "стопка красивых,"
  },
  {
   "t0": 3.186,
   "t1": 3.533,
   "text": "и ни"
  },
  {
   "t0": 3.533,
   "t1": 4.813,
   "text": "одной строчки."
  },
  {
   "t0": 4.813,
   "t1": 5.213,
   "text": "Но дело"
  },
  {
   "t0": 5.213,
   "t1": 6.237,
   "text": "не в почерке,"
  },
  {
   "t0": 6.237,
   "t1": 7.453,
   "text": "в конце покажу,"
  },
  {
   "t0": 7.453,
   "t1": 8.893,
   "text": "как тебе начать."
  },
  {
   "t0": 8.893,
   "t1": 9.213,
   "text": "У меня"
  },
  {
   "t0": 9.213,
   "t1": 9.853,
   "text": "в ящике"
  },
  {
   "t0": 9.853,
   "t1": 10.813,
   "text": "пять блокнотов,"
  },
  {
   "t0": 10.813,
   "t1": 12.146,
   "text": "и все пустые."
  },
  {
   "t0": 12.146,
   "t1": 13.053,
   "text": "Знакомо?"
  },
  {
   "t0": 13.053,
   "t1": 13.493,
   "text": "Напиши в"
  },
  {
   "t0": 13.493,
   "t1": 14.306,
   "text": "комментах кот,"
  },
  {
   "t0": 14.306,
   "t1": 14.973,
   "text": "и Напарник"
  },
  {
   "t0": 14.973,
   "t1": 16.173,
   "text": "посидит с тобой."
  },
  {
   "t0": 16.173,
   "t1": 17.213,
   "text": "Чистая страница"
  },
  {
   "t0": 17.213,
   "t1": 18.413,
   "text": "кажется дороже,"
  },
  {
   "t0": 18.413,
   "t1": 19.373,
   "text": "и первая строчка"
  },
  {
   "t0": 19.373,
   "t1": 20.84,
   "text": "будто её испортит."
  },
  {
   "t0": 20.84,
   "t1": 21.933,
   "text": "Поэтому испорти"
  },
  {
   "t0": 21.933,
   "t1": 22.76,
   "text": "её сам:"
  },
  {
   "t0": 22.76,
   "t1": 23.693,
   "text": "на первой странице"
  },
  {
   "t0": 23.693,
   "t1": 25.513,
   "text": "нарисуй каракулю."
  },
  {
   "t0": 25.513,
   "t1": 26.113,
   "text": "Я нарисовал"
  },
  {
   "t0": 26.113,
   "t1": 27.033,
   "text": "кривого кота,"
  },
  {
   "t0": 27.033,
   "t1": 28.033,
   "text": "и дальше писалось"
  },
  {
   "t0": 28.033,
   "t1": 28.98,
   "text": "само."
  }
 ]
}