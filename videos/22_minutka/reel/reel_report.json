 "captions": [
  {
   "t0": 0.0,
   "t1": 0.52,
   "text": "Ляжешь на минутку,"
  },
  {
   "t0": 0.52,
   "t1": 0.87,
   "text": "а уже"
  },
  {
   "t0": 0.87,
   "t1": 2.313,
   "text": "ночь?"
  },
  {
   "t0": 2.313,
   "t1": 3.433,
   "text": "Подушка, телефон,"
  },
  {
   "t0": 3.433,
   "t1": 4.393,
   "text": "ещё видео,"
  },
  {
   "t0": 4.393,
   "t1": 5.593,
   "text": "и дня нет."
  },
  {
   "t0": 5.593,
   "t1": 5.913,
   "text": "Но это"
  },
  {
   "t0": 5.913,
   "t1": 6.777,
   "text": "не слабость,"
  },
  {
   "t0": 6.777,
   "t1": 6.953,
   "text": "и в"
  },
  {
   "t0": 6.953,
   "t1": 8.153,
   "text": "конце покажу,"
  },
  {
   "t0": 8.153,
   "t1": 9.433,
   "text": "как тебе встать."
  },
  {
   "t0": 9.433,
   "t1": 9.753,
   "text": "Я лёг"
  },
  {
   "t0": 9.753,
   "t1": 10.153,
   "text": "в два"
  },
  {
   "t0": 10.153,
   "t1": 10.953,
   "text": "«на пять минут»,"
  },
  {
   "t0": 10.953,
   "t1": 11.513,
   "text": "а встал"
  },
  {
   "t0": 11.513,
   "t1": 12.233,
   "text": "в семь."
  },
  {
   "t0": 12.233,
   "t1": 13.193,
   "text": "Это про тебя?"
  },
  {
   "t0": 13.193,
   "t1": 13.913,
   "text": "Напиши под видео"
  },
  {
   "t0": 13.913,
   "t1": 14.873,
   "text": "в комментах кот,"
  },
  {
   "t0": 14.873,
   "t1": 16.206,
   "text": "и Напарник разбудит"
  },
  {
   "t0": 16.206,
   "t1": 17.273,
   "text": "тебя к делу."
  },
  {
   "t0": 17.273,
   "t1": 18.366,
   "text": "Лёжа нет момента,"
  },
  {
   "t0": 18.366,
   "t1": 19.513,
   "text": "когда пора встать,"
  },
  {
   "t0": 19.513,
   "t1": 20.9,
   "text": "и минутка тянется."
  },
  {
   "t0": 20.9,
   "t1": 21.353,
   "text": "Поэтому"
  },
  {
   "t0": 21.353,
   "t1": 22.773,
   "text": "отдыхай сидя,"
  },
  {
   "t0": 22.773,
   "t1": 23.493,
   "text": "а будильник"
  },
  {
   "t0": 23.493,
   "t1": 24.826,
   "text": "клади через комнату."
  },
  {
   "t0": 24.826,
   "t1": 25.733,
   "text": "Он зазвенел,"
  },
  {
   "t0": 25.733,
   "t1": 26.293,
   "text": "я дошёл"
  },
  {
   "t0": 26.293,
   "t1": 26.906,
   "text": "до него,"
  },
  {
   "t0": 26.906,
   "t1": 28.08,
   "text": "и не лёг."
  }
 ]
}