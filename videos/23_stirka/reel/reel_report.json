 "captions": [
  {
   "t0": 0.0,
   "t1": 0.48,
   "text": "Стирка час,"
  },
  {
   "t0": 0.48,
   "t1": 0.8,
   "text": "а достаёшь"
  },
  {
   "t0": 0.8,
   "t1": 2.333,
   "text": "неделю?"
  },
  {
   "t0": 2.333,
   "t1": 2.853,
   "text": "Включишь"
  },
  {
   "t0": 2.853,
   "t1": 3.693,
   "text": "и забудешь,"
  },
  {
   "t0": 3.693,
   "t1": 4.093,
   "text": "а там"
  },
  {
   "t0": 4.093,
   "t1": 5.213,
   "text": "уже запах."
  },
  {
   "t0": 5.213,
   "t1": 5.693,
   "text": "Но это"
  },
  {
   "t0": 5.693,
   "t1": 6.477,
   "text": "не память,"
  },
  {
   "t0": 6.477,
   "t1": 7.133,
   "text": "и в конце"
  },
  {
   "t0": 7.133,
   "t1": 8.173,
   "text": "покажу, как тебе"
  },
  {
   "t0": 8.173,
   "t1": 9.213,
   "text": "не забыть."
  },
  {
   "t0": 9.213,
   "t1": 9.773,
   "text": "Я постирал"
  },
  {
   "t0": 9.773,
   "t1": 10.653,
   "text": "в понедельник,"
  },
  {
   "t0": 10.653,
   "t1": 11.133,
   "text": "а достал"
  },
  {
   "t0": 11.133,
   "t1": 12.173,
   "text": "в пятницу."
  },
  {
   "t0": 12.173,
   "t1": 13.133,
   "text": "Было такое?"
  },
  {
   "t0": 13.133,
   "t1": 13.613,
   "text": "Напиши в"
  },
  {
   "t0": 13.613,
   "t1": 14.466,
   "text": "комментах кот,"
  },
  {
   "t0": 14.466,
   "t1": 15.666,
   "text": "и Напарник напомнит"
  },
  {
   "t0": 15.666,
   "t1": 16.813,
   "text": "тебе закончить."
  },
  {
   "t0": 16.813,
   "t1": 17.826,
   "text": "Нажмёшь кнопку,"
  },
  {
   "t0": 17.826,
   "t1": 18.413,
   "text": "и в голове"
  },
  {
   "t0": 18.413,
   "t1": 19.693,
   "text": "стирка уже готова,"
  },
  {
   "t0": 19.693,
   "t1": 21.16,
   "text": "а машинка молчит."
  },
  {
   "t0": 21.16,
   "t1": 21.773,
   "text": "Поэтому, как"
  },
  {
   "t0": 21.773,
   "t1": 22.813,
   "text": "нажмёшь кнопку,"
  },
  {
   "t0": 22.813,
   "t1": 24.153,
   "text": "ставь пустой таз"
  },
  {
   "t0": 24.153,
   "t1": 24.953,
   "text": "на порог."
  },
  {
   "t0": 24.953,
   "t1": 26.073,
   "text": "Утром я споткнулся"
  },
  {
   "t0": 26.073,
   "t1": 26.553,
   "text": "о таз"
  },
  {
   "t0": 26.553,
   "t1": 27.113,
   "text": "и сразу"
  },
  {
   "t0": 27.113,
   "t1": 28.34,
   "text": "вспомнил."
  }
 ]
