 "captions": [
  {
   "t0": 0.0,
   "t1": 0.48,
   "text": "Стирка час,"
  },
  {
   "t0": 0.48,
   "t1": 0.95,
   "text": "а достаёшь"
  },
  {
   "t0": 0.95,
   "t1": 2.633,
   "text": "неделю?"
  },
  {
   "t0": 2.633,
   "t1": 3.153,
   "text": "Включишь"
  },
  {
   "t0": 3.153,
   "t1": 3.993,
   "text": "и забудешь,"
  },
  {
   "t0": 3.993,
   "t1": 4.393,
   "text": "а там"
  },
  {
   "t0": 4.393,
   "t1": 5.513,
   "text": "уже запах."
  },
  {
   "t0": 5.513,
   "t1": 5.993,
   "text": "Но это"
  },
  {
   "t0": 5.993,
   "t1": 6.777,
   "text": "не память,"
  },
  {
   "t0": 6.777,
   "t1": 7.433,
   "text": "и в конце"
  },
  {
   "t0": 7.433,
   "t1": 8.473,
   "text": "покажу, как тебе"
  },
  {
   "t0": 8.473,
   "t1": 9.513,
   "text": "не забыть."
  },
  {
   "t0": 9.513,
   "t1": 10.073,
   "text": "Я постирал"
  },
  {
   "t0": 10.073,
   "t1": 10.953,
   "text": "в понедельник,"
  },
  {
   "t0": 10.953,
   "t1": 11.433,
   "text": "а достал"
  },
  {
   "t0": 11.433,
   "t1": 12.473,
   "text": "в пятницу."
  },
  {
   "t0": 12.473,
   "t1": 13.433,
   "text": "Было такое?"
  },
  {
   "t0": 13.433,
   "t1": 13.913,
   "text": "Напиши в"
  },
  {
   "t0": 13.913,
   "t1": 14.766,
   "text": "комментах кот,"
  },
  {
   "t0": 14.766,
   "t1": 15.966,
   "text": "и Напарник напомнит"
  },
  {
   "t0": 15.966,
   "t1": 17.113,
   "text": "тебе закончить."
  },
  {
   "t0": 17.113,
   "t1": 18.126,
   "text": "Нажмёшь кнопку,"
  },
  {
   "t0": 18.126,
   "t1": 18.713,
   "text": "и в голове"
  },
  {
   "t0": 18.713,
   "t1": 19.993,
   "text": "стирка уже готова,"
  },
  {
   "t0": 19.993,
   "t1": 21.46,
   "text": "а машинка молчит."
  },
  {
   "t0": 21.46,
   "t1": 22.073,
   "text": "Поэтому, как"
  },
  {
   "t0": 22.073,
   "t1": 23.113,
   "text": "нажмёшь кнопку,"
  },
  {
   "t0": 23.113,
   "t1": 24.453,
   "text": "ставь пустой таз"
  },
  {
   "t0": 24.453,
   "t1": 25.253,
   "text": "на порог."
  },
  {
   "t0": 25.253,
   "t1": 26.373,
   "text": "Утром я споткнулся"
  },
  {
   "t0": 26.373,
   "t1": 26.853,
   "text": "о таз"
  },
  {
