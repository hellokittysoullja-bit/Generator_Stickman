 "captions": [
  {
   "t0": 0.0,
   "t1": 1.449,
   "text": "Тебе трудно решить?"
  },
  {
   "t0": 1.449,
   "t1": 2.009,
   "text": "Даже что"
  },
  {
   "t0": 2.009,
   "t1": 2.609,
   "text": "на ужин"
  },
  {
   "t0": 2.609,
   "t1": 3.906,
   "text": "или что включить,"
  },
  {
   "t0": 3.906,
   "t1": 4.809,
   "text": "и дело совсем"
  },
  {
   "t0": 4.809,
   "t1": 5.369,
   "text": "не в том,"
  },
  {
   "t0": 5.369,
   "t1": 5.609,
   "text": "что ты"
  },
  {
   "t0": 5.609,
   "t1": 6.702,
   "text": "слабее других."
  },
  {
   "t0": 6.702,
   "t1": 7.449,
   "text": "Но в конце"
  },
  {
   "t0": 7.449,
   "t1": 7.969,
   "text": "ты будешь"
  },
  {
   "t0": 7.969,
   "t1": 9.129,
   "text": "решать быстрее"
  },
  {
   "t0": 9.129,
   "t1": 10.329,
   "text": "и не пожалеешь."
  },
  {
   "t0": 10.329,
   "t1": 10.849,
   "text": "В магазине"
  },
  {
   "t0": 10.849,
   "t1": 11.369,
   "text": "с двадцатью"
  },
  {
   "t0": 11.369,
   "t1": 12.329,
   "text": "четырьмя джемами"
  },
  {
   "t0": 12.329,
   "t1": 13.129,
   "text": "купили трое"
  },
  {
   "t0": 13.129,
   "t1": 13.769,
   "text": "из ста,"
  },
  {
   "t0": 13.769,
   "t1": 14.729,
   "text": "а с шестью"
  },
  {
   "t0": 14.729,
   "t1": 15.662,
   "text": "тридцать."
  },
  {
   "t0": 15.662,
   "t1": 16.969,
   "text": "Мозг ищет лучшее,"
  },
  {
   "t0": 16.969,
   "t1": 17.809,
   "text": "и психолог Барри"
  },
  {
   "t0": 17.809,
   "t1": 18.969,
   "text": "Шварц заметил:"
  },
  {
   "t0": 18.969,
   "t1": 19.649,
   "text": "так выбирают"
  },
  {
   "t0": 19.649,
   "t1": 20.329,
   "text": "дольше и"
  },
  {
   "t0": 20.329,
   "t1": 21.476,
   "text": "чаще жалеют."
  },
  {
   "t0": 21.476,
   "t1": 22.272,
   "text": "Поэтому"
  },
  {
   "t0": 22.272,
   "t1": 23.499,
   "text": "назови заранее одно,"
  },
  {
   "t0": 23.499,
   "t1": 24.432,
   "text": "что тебе важно,"
  },
  {
   "t0": 24.432,
   "t1": 25.259,
   "text": "и бери первое,"
  },
  {
   "t0": 25.259,
   "t1": 26.192,
   "text": "что подходит."
  },
  {
   "t0": 26.192,
   "t1": 27.099,
   "text": "В шапке профиля"
  },
  {
   "t0": 27.099,
   "t1": 27.859,
   "text": "я помогу тебе"
  },
  {
   "t0": 27.859,
   "t1": 28.966,
   "text": "начать твоё дело,"
  },
  {
   "t0": 28.966,
   "t1": 29.339,
   "text": "а также"
  },
  {
   "t0": 29.339,
   "t1": 30.059,
   "text": "посижу с тобой"
  },
  {
   "t0": 30.059,
   "t1": 30.592,
   "text": "пару минут,"
  },
  {
   "t0": 30.592,
   "t1": 31.859,
   "text": "пока ты начинаешь."
  },
  {
   "t0": 31.859,
   "t1": 32.699,
   "text": "Бесплатно."
  },
  {
   "t0": 32.699,
   "t1": 33.219,
   "text": "Смотри, что"
  },
  {
   "t0": 33.219,
   "t1": 34.139,
   "text": "было дальше."
  },
  {
   "t0": 34.139,
   "t1": 35.339,
   "text": "Я сказал «тёплое»,"
  },
  {
   "t0": 35.339,
   "t1": 36.339,
   "text": "взял первый чай"
  },
  {
   "t0": 36.339,
   "t1": 37.259,
   "text": "и не пожалел,"
  },
  {
   "t0": 37.259,
   "t1": 37.739,
   "text": "а экран"
  },
  {
   "t0": 37.739,
   "t1": 39.286,
   "text": "листает без меня."
  }
 ]
