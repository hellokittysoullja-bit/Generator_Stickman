 "captions": [
  {
   "t0": 0.0,
   "t1": 0.52,
   "text": "Ты знаешь как,"
  },
  {
   "t0": 0.52,
   "t1": 1.759,
   "text": "а не делаешь?"
  },
  {
   "t0": 1.759,
   "t1": 2.519,
   "text": "Сто советов"
  },
  {
   "t0": 2.519,
   "t1": 3.159,
   "text": "в голове,"
  },
  {
   "t0": 3.159,
   "t1": 4.548,
   "text": "а дело стоит."
  },
  {
   "t0": 4.548,
   "t1": 5.399,
   "text": "Хотя знаний"
  },
  {
   "t0": 5.399,
   "t1": 6.399,
   "text": "тебе хватает,"
  },
  {
   "t0": 6.399,
   "t1": 6.999,
   "text": "и в конце"
  },
  {
   "t0": 6.999,
   "t1": 7.679,
   "text": "я скажу,"
  },
  {
   "t0": 7.679,
   "t1": 9.359,
   "text": "чего не хватает."
  },
  {
   "t0": 9.359,
   "t1": 10.079,
   "text": "Я сорок"
