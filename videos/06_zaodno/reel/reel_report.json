 "captions": [
  {
   "t0": 0.0,
   "t1": 1.24,
   "text": "Идёшь убираться?"
  },
  {
   "t0": 1.24,
   "t1": 1.92,
   "text": "А через час"
  },
  {
   "t0": 1.92,
   "t1": 2.84,
   "text": "уже кино?"
  },
  {
   "t0": 2.84,
   "t1": 3.24,
   "text": "Но это"
  },
  {
   "t0": 3.24,
   "t1": 4.2,
   "text": "не лень:"
  },
  {
   "t0": 4.2,
   "t1": 5.2,
   "text": "полы я домыл,"
  },
  {
   "t0": 5.2,
   "t1": 5.96,
   "text": "когда поймал"
  },
  {
   "t0": 5.96,
   "t1": 7.24,
   "text": "одно слово."
  },
  {
   "t0": 7.24,
   "t1": 7.8,
   "text": "Оно даже"
  },
  {
   "t0": 7.8,
   "t1": 9.04,
   "text": "звучит полезно,"
  },
  {
   "t0": 9.04,
   "t1": 9.56,
   "text": "а раньше"
  },
  {
   "t0": 9.56,
   "t1": 10.24,
   "text": "уводило меня"
  },
  {
   "t0": 10.24,
   "t1": 11.32,
   "text": "всё дальше:"
  },
  {
   "t0": 11.32,
   "t1": 12.92,
   "text": "цветы, стирка,"
  },
  {
   "t0": 12.92,
   "t1": 13.28,
   "text": "и вот"
  },
  {
   "t0": 13.28,
   "t1": 14.44,
   "text": "уже кино."
  },
  {
   "t0": 14.44,
   "t1": 14.92,
   "text": "Я думал,"
  },
  {
   "t0": 14.92,
   "t1": 15.6,
   "text": "что не умею"
  },
  {
   "t0": 15.6,
   "t1": 16.76,
   "text": "ничего доводить."
  },
  {
   "t0": 16.76,
   "t1": 18.11,
   "text": "А это слово"
  },
  {
   "t0": 18.11,
   "t1": 19.15,
   "text": "«заодно»."
  },
  {
   "t0": 19.15,
   "t1": 19.71,
