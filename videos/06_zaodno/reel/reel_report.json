 "captions": [
  {
   "t0": 0.0,
   "t1": 1.24,
   "text": "Идёшь мыть полы?"
  },
  {
   "t0": 1.24,
   "t1": 1.64,
   "text": "А через"
  },
  {
   "t0": 1.64,
   "t1": 2.36,
   "text": "час сажаешь"
  },
  {
   "t0": 2.36,
   "t1": 3.24,
   "text": "цветы?"
  },
  {
   "t0": 3.24,
   "t1": 3.64,
   "text": "Но это"
  },
  {
   "t0": 3.64,
   "t1": 4.52,
   "text": "не лень."
  },
  {
   "t0": 4.52,
   "t1": 5.32,
   "text": "Тебя уводит"
  },
  {
   "t0": 5.32,
   "t1": 6.68,
   "text": "одно слово."
  },
  {
   "t0": 6.68,
   "t1": 7.64,
   "text": "Я его поймал"
  },
  {
   "t0": 7.64,
   "t1": 9.16,
   "text": "и домыл полы."
  },
  {
   "t0": 9.16,
   "t1": 9.88,
   "text": "Раньше оно"
  },
  {
   "t0": 9.88,
   "t1": 10.56,
   "text": "уводило меня"
  },
  {
   "t0": 10.56,
   "t1": 11.56,
   "text": "всё дальше:"
  },
  {
   "t0": 11.56,
   "t1": 13.08,
   "text": "цветы, стирка,"
  },
  {
   "t0": 13.08,
   "t1": 13.4,
   "text": "и вот"
  },
  {
   "t0": 13.4,
   "t1": 14.52,
   "text": "уже кино."
  },
  {
   "t0": 14.52,
   "t1": 15.027,
   "text": "Я думал,"
  },
  {
   "t0": 15.027,
   "t1": 15.64,
   "text": "что не умею"
  },
  {
   "t0": 15.64,
   "t1": 17.08,
   "text": "ничего доводить."
  },
  {
   "t0": 17.08,
   "t1": 18.57,
   "text": "А это слово"
  },
  {
   "t0": 18.57,
   "t1": 19.61,
   "text": "«заодно»."
  },
  {
   "t0": 19.61,
