   "t0": 25.41,
   "t1": 26.29,
   "text": "его на бумажку"
  },
  {
   "t0": 26.29,
   "t1": 26.69,
   "text": "и иду"
  },
  {
   "t0": 26.69,
   "t1": 27.97,
   "text": "обратно к ведру."
  },
  {
   "t0": 27.97,
   "t1": 28.57,
   "text": "Цветы ждут"
  },
  {
   "t0": 28.57,
   "t1": 29.53,
   "text": "на бумажке,"
  },
  {
   "t0": 29.53,
   "t1": 30.13,
   "text": "а полы"
  },
  {
   "t0": 30.13,
   "t1": 31.41,
   "text": "уже помыты."
  },
  {
   "t0": 31.41,
   "t1": 32.53,
   "text": "Напиши в комментах,"
  },
  {
   "t0": 32.53,
   "t1": 33.89,
