   "t1": 2.61,
   "text": "час я"
  },
  {
   "t0": 2.61,
   "t1": 4.05,
   "text": "уже сажал цветы."
  },
  {
   "t0": 4.05,
   "t1": 4.69,
   "text": "Садишься за"
  },
  {
   "t0": 4.69,
   "t1": 5.61,
   "text": "одно дело,"
  },
  {
   "t0": 5.61,
   "t1": 6.17,
   "text": "а делаешь"
  },
  {
   "t0": 6.17,
   "t1": 7.33,
   "text": "уже пятое."
  },
  {
   "t0": 7.33,
   "t1": 7.73,
   "text": "И это"
  },
  {
   "t0": 7.73,
   "t1": 8.61,
   "text": "не лень."
  },
  {
   "t0": 8.61,
   "t1": 10.13,
   "text": "Каждое «заодно»"
  },
  {
   "t0": 10.13,
   "t1": 11.41,
   "text": "уводит дальше:"
  },
  {
   "t0": 11.41,
   "t1": 12.85,
   "text": "цветы, стирка,"
  },
  {
   "t0": 12.85,
   "t1": 13.53,
   "text": "чайник,"
  },
  {
   "t0": 13.53,
   "t1": 13.81,
   "text": "и вот"
  },
  {
   "t0": 13.81,
   "t1": 14.93,
   "text": "уже кино."
  },
  {
   "t0": 14.93,
   "t1": 15.29,
   "text": "У меня"
  },
  {
   "t0": 15.29,
   "t1": 16.37,
   "text": "тоже так."
  },
  {
   "t0": 16.37,
   "t1": 16.85,
   "text": "Я думал,"
  },
  {
   "t0": 16.85,
   "t1": 17.61,
   "text": "что не умею"
  },
  {
   "t0": 17.61,
   "t1": 18.93,
   "text": "ничего доводить."
  },
  {
   "t0": 18.93,
   "t1": 19.97,
   "text": "А потом заметил,"
  },
  {
   "t0": 19.97,
   "t1": 20.73,
   "text": "где именно"
  },
  {
   "t0": 20.73,
   "t1": 21.77,
   "text": "я теряюсь:"
  },
  {
   "t0": 21.77,
   "t1": 23.65,
   "text": "на слове «заодно»."
  },
  {
   "t0": 23.65,
   "t1": 24.09,
   "text": "Как только"
  },
  {
   "t0": 24.09,
   "t1": 25.01,
   "text": "оно звучит,"
  },
  {
   "t0": 25.01,
   "t1": 25.41,
   "text": "я пишу"
  },
