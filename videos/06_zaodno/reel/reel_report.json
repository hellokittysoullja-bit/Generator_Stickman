  {
   "t0": 3.16,
   "t1": 4.36,
   "text": "как так вышло?"
  },
  {
   "t0": 4.36,
   "t1": 5.48,
   "text": "Это не лень."
  },
  {
   "t0": 5.48,
   "t1": 5.92,
   "text": "И полы"
  },
  {
   "t0": 5.92,
   "t1": 6.92,
