 "captions": [
  {
   "t0": 0.0,
   "t1": 1.32,
   "text": "Идёшь убираться?"
  },
  {
   "t0": 1.32,
   "t1": 2.0,
   "text": "А через час"
  },
  {
   "t0": 2.0,
   "t1": 3.08,
   "text": "смотришь сериал?"
  },
  {
   "t0": 3.08,
   "t1": 3.48,
   "text": "Но это"
  },
  {
   "t0": 3.48,
   "t1": 4.406,
   "text": "не лень:"
  },
  {
   "t0": 4.406,
   "t1": 4.64,
   "text": "полы я"
  },
  {
   "t0": 4.64,
   "t1": 5.28,
   "text": "домыл, когда"
  },
  {
   "t0": 5.28,
   "t1": 6.52,
   "text": "поймал одно"
  },
  {
   "t0": 6.52,
   "t1": 7.4,
   "text": "слово."
  },
  {
   "t0": 7.4,
   "t1": 7.8,
   "text": "Оно даже"
  },
  {
   "t0": 7.8,
   "t1": 9.0,
   "text": "звучит полезно,"
  },
  {
   "t0": 9.0,
   "t1": 9.48,
   "text": "а раньше"
  },
  {
   "t0": 9.48,
   "t1": 10.12,
   "text": "уводило меня"
  },
  {
   "t0": 10.12,
   "t1": 11.08,
   "text": "всё дальше:"
  },
  {
   "t0": 11.08,
   "t1": 12.36,
   "text": "цветы, стирка,"
  },
  {
   "t0": 12.36,
   "t1": 12.76,
   "text": "и вот"
  },
  {
   "t0": 12.76,
   "t1": 13.72,
   "text": "уже сериал."
  },
  {
   "t0": 13.72,
   "t1": 14.12,
   "text": "Я думал,"
  },
  {
   "t0": 14.12,
   "t1": 14.76,
   "text": "что не умею"
  },
  {
   "t0": 14.76,
   "t1": 15.96,
   "text": "ничего доводить."
  },
  {
   "t0": 15.96,
   "t1": 17.22,
   "text": "А это слово"
  },
  {
   "t0": 17.22,
   "t1": 18.14,
   "text": "«заодно»."
  },
  {
   "t0": 18.14,
   "t1": 18.58,
   "text": "Как только"
  },
  {
