 "captions": [
  {
   "t0": 0.0,
   "t1": 1.24,
   "text": "Идёшь мыть полы?"
  },
  {
   "t0": 1.24,
   "t1": 1.8,
   "text": "А через"
  },
  {
   "t0": 1.8,
   "t1": 2.44,
   "text": "час сажаешь"
  },
  {
   "t0": 2.44,
   "t1": 3.32,
   "text": "цветы?"
  },
  {
   "t0": 3.32,
   "t1": 3.72,
   "text": "Но это"
  },
  {
   "t0": 3.72,
   "t1": 4.52,
   "text": "не лень,"
  },
  {
   "t0": 4.52,
   "t1": 5.16,
   "text": "и полы я"
  },
  {
   "t0": 5.16,
   "t1": 6.36,
   "text": "в итоге домыл."
  },
  {
   "t0": 6.36,
   "t1": 7.32,
   "text": "Тебя уводило"
  },
  {
   "t0": 7.32,
   "t1": 8.76,
   "text": "одно слово."
  },
  {
   "t0": 8.76,
   "t1": 9.44,
   "text": "Раньше оно"
  },
  {
   "t0": 9.44,
   "t1": 10.12,
   "text": "уводило меня"
  },
  {
   "t0": 10.12,
   "t1": 11.24,
   "text": "всё дальше:"
  },
  {
   "t0": 11.24,
   "t1": 12.8,
   "text": "цветы, стирка,"
  },
  {
   "t0": 12.8,
   "t1": 13.08,
   "text": "и вот"
  },
  {
   "t0": 13.08,
   "t1": 14.2,
   "text": "уже кино."
  },
  {
   "t0": 14.2,
   "t1": 14.68,
   "text": "Я думал,"
  },
  {
   "t0": 14.68,
   "t1": 15.36,
   "text": "что не умею"
  },
  {
   "t0": 15.36,
   "t1": 16.68,
   "text": "ничего доводить."
  },
  {
   "t0": 16.68,
   "t1": 18.17,
   "text": "А это слово"
  },
  {
   "t0": 18.17,
   "t1": 19.29,
   "text": "«заодно»."
  },
  {
   "t0": 19.29,
